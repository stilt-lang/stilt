---
// Stilt's mark: the arc of the sky over the horizon, and a star above it, which moves out a
// little when the wordmark is hovered.
---

<svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
  <path d="M4 22a12 12 0 0 1 24 0" fill="none" stroke="currentColor" stroke-width="3.25" stroke-linecap="round"></path>
  <circle class="star" cx="22.5" cy="7.5" r="2.9" fill="currentColor"></circle>
</svg>

<style>
  .mark { width: 1.375rem; height: 1.375rem; flex: none; overflow: visible; }
  .star { transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(a:hover) > .mark .star { transform: translate(1.6px, -1.6px); }
  @media (prefers-reduced-motion: reduce) {
    .star { transition: none; }
  }
</style>
