---
// Stilt's mark, a stilt that stoops to feed, in the cut for small sizes (brand/README.md). It
// takes the text's colour, and its legs the accent.
import { smallMark } from "../lib/brand";
---

<svg class="stilt-mark" viewBox="0 0 1000 1000" aria-hidden="true" set:html={smallMark} />

<style>
  .stilt-mark { width: 1.375rem; height: 1.375rem; flex: none; }
</style>
