---
// The header: the name, the parts of the site, search, the theme and the repository. It stays at
// the top, and draws its hairline once the page scrolls under it. On a narrow screen the parts
// fold into a menu.
import type { Section } from "../lib/map";
import { PARTS } from "../lib/nav";
import Logo from "./Logo.astro";
import Theme from "./Theme.astro";

interface Props {
  section: Section;
  wide: boolean;
}
const { section, wide } = Astro.props;
const repository = "https://github.com/stilt-lang/stilt";
---

<header class="topbar">
  <div class:list={["shell flex h-full items-center justify-between gap-4", wide && "shell-wide"]}>
    <div class="flex items-center gap-8">
      <a href="/" class="name" aria-label="Stilt, the front page">
        <Logo size="small" />
      </a>
      <nav class="hidden items-center gap-1 lg:flex" aria-label="The site">
        {
          PARTS.map((part) => (
            <a href={part.href} class="part" aria-current={part.section === section ? "page" : undefined}>
              {part.name}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="flex items-center gap-1.5">
      <button type="button" class="search-open" data-search-open aria-label="Search the site">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="m13.2 13.2 3.6 3.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        <span class="hidden xl:inline">Search</span>
        <span class="kbd hidden xl:inline">⌘K</span>
      </button>
      <Theme />
      <a href={repository} class="icon" aria-label="Stilt on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"></path></svg>
      </a>
      <details class="menu lg:hidden">
        <summary class="icon" aria-label="The site's parts">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </summary>
        <nav class="menu-panel" aria-label="The site">
          {
            PARTS.map((part) => (
              <a href={part.href} aria-current={part.section === section ? "page" : undefined}>
                {part.name}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const bar = document.querySelector<HTMLElement>(".topbar")!;
  const mark = () => (bar.dataset.scrolled = String(window.scrollY > 4));
  addEventListener("scroll", mark, { passive: true });
  mark();
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }
  .topbar[data-scrolled="true"] { border-bottom-color: var(--rule); }
  .name { display: inline-flex; color: var(--ink); text-decoration: none; }
  .part {
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .part:hover { color: var(--ink); }
  .part[aria-current="page"] { color: var(--ink); background: var(--surface); box-shadow: inset 0 0 0 1px var(--rule); }
  .search-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.125rem;
    padding: 0 0.625rem 0 0.75rem;
    border: 1px solid var(--rule-firm);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .search-open:hover { color: var(--ink); border-color: var(--muted); }
  .search-open svg { width: 1rem; height: 1rem; flex: none; }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .icon:hover { color: var(--ink); }
  .icon svg { width: 1.0625rem; height: 1.0625rem; }
  .menu { position: relative; }
  .menu summary { list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    display: flex;
    flex-direction: column;
    min-width: 12rem;
    padding: 0.375rem;
    background: var(--ground);
    border: 1px solid var(--rule);
    border-radius: 12px;
  }
  .menu-panel a { padding: 0.5rem 0.75rem; border-radius: 8px; text-decoration: none; color: var(--ink-soft); }
  .menu-panel a[aria-current="page"], .menu-panel a:hover { background: var(--surface); color: var(--ink); }
</style>
