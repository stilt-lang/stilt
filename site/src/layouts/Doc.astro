---
// A document's page: its part's list on the left, each group folded unless it holds the page,
// the document in the middle, the headings of the page on the right, and the pages before and
// after it under it. The middle column's code and tables may be wider than its running text,
// but never wider than the column, which scrolls them inside itself.
import { escape } from "../lib/highlight";
import type { Section } from "../lib/map";
import type { Heading } from "../lib/markdown";
import { type Block, neighbours } from "../lib/nav";
import Base from "./Base.astro";

interface Props {
  title: string;
  section: Section;
  href: string;
  blocks: Block[];
  headings?: Heading[];
  description?: string;
}

const { title, section, href, blocks, headings = [], description } = Astro.props;
const { previous, next } = neighbours(blocks, href);
const contents = headings.filter((h) => h.id && h.depth === 2);

/** The part's list, each group a fold under its heading, the page itself marked. */
function list(blocks: Block[], at: string): string {
  return blocks
    .map((b) => {
      const items = b.links
        .map((l) => {
          const current = l.href === at ? ' aria-current="page"' : "";
          const note = l.note ? `<span class="note">${escape(l.note)}</span>` : "";
          return `<li><a href="${l.href}"${current}>${note}<span>${escape(l.title)}</span></a></li>`;
        })
        .join("");
      if (!b.heading) return `<ul class="top">${items}</ul>`;
      const open = b.links.some((l) => l.href === at) ? " open" : "";
      return `<details class="group"${open}><summary>${escape(b.heading)}</summary><ul>${items}</ul></details>`;
    })
    .join("");
}
---

<Base title={title} section={section} description={description} wide>
  <div class="doc shell shell-wide">
    {
      blocks.length > 0 && (
        <aside class="sidebar" aria-label="Pages of this part" data-pagefind-ignore>
          <details class="sidebar-fold">
            <summary>Contents</summary>
            <nav set:html={list(blocks, href)} />
          </details>
          <nav class="sidebar-rail" set:html={list(blocks, href)} />
        </aside>
      )
    }
    <article class:list={["article", blocks.length === 0 && "article-alone"]}>
      <slot name="title" />
      <div class="prose">
        <slot />
      </div>
      {
        (previous || next) && (
          <nav class="pager" aria-label="Pages around this one" data-pagefind-ignore>
            {previous ? (
              <a href={previous.href} class="pager-link" rel="prev">
                <span class="pager-dir">Previous</span>
                <span class="pager-title">{previous.title}</span>
              </a>
            ) : <span />}
            {next && (
              <a href={next.href} class="pager-link pager-next" rel="next">
                <span class="pager-dir">Next</span>
                <span class="pager-title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>
    {
      contents.length > 1 && (
        <aside class="toc" aria-label="On this page" data-pagefind-ignore>
          <nav>
            <p class="toc-title">On this page</p>
            <ol>
              {contents.map((h) => (
                <li>
                  <a href={`#${h.id}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // The contents mark the heading the reader is at.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>(".toc a")].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
  );
  if (links.size) {
    const seen = new Set<string>();
    const mark = () => {
      const at = [...links.keys()].find((id) => seen.has(id));
      if (at) for (const [id, a] of links) a.toggleAttribute("data-at", id === at);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id));
        mark();
      },
      { rootMargin: "-64px 0px -55% 0px" },
    );
    for (const id of links.keys()) {
      const target = document.getElementById(id);
      if (target) observer.observe(target);
    }
  }
  // The rail shows the page's own link.
  const rail = document.querySelector<HTMLElement>(".sidebar-rail");
  const current = rail?.querySelector<HTMLElement>("[aria-current]");
  if (rail && current) rail.scrollTop = current.offsetTop - rail.clientHeight / 2;
</script>

<style>
  .doc { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 3rem; }
  @media (min-width: 64rem) {
    .doc { grid-template-columns: 15rem minmax(0, 1fr); }
  }
  @media (min-width: 80rem) {
    .doc:has(.toc) { grid-template-columns: 15rem minmax(0, 1fr) 13rem; }
  }
  .article { min-width: 0; max-width: 44rem; padding-block: 2.5rem 4rem; }
  .article-alone { grid-column: 1 / -1; margin-inline: auto; width: 100%; }
  @media (min-width: 64rem) { .article { padding-top: 3rem; } }

  .sidebar { min-width: 0; }
  .sidebar-rail { display: none; }
  @media (min-width: 64rem) {
    .sidebar-fold { display: none; }
    .sidebar-rail {
      display: block;
      position: sticky;
      top: var(--header);
      max-height: calc(100dvh - var(--header));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 3rem 0.5rem 3rem 0;
      scrollbar-width: thin;
    }
  }
  .sidebar-fold { border-bottom: 1px solid var(--rule); }
  .sidebar-fold > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0.625rem 0.875rem 0;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .sidebar-fold > summary::-webkit-details-marker { display: none; }
  .sidebar-fold > summary::after,
  .sidebar :global(.group > summary::after) {
    content: "";
    width: 0.4375rem;
    height: 0.4375rem;
    flex: none;
    margin-right: 0.25rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.15s ease;
  }
  .sidebar-fold:not([open]) > summary::after,
  .sidebar :global(.group:not([open]) > summary::after) { transform: rotate(-45deg); }
  .sidebar :global(ul) { display: flex; flex-direction: column; gap: 1px; list-style: none; padding: 0; margin: 0; }
  .sidebar :global(.top) { margin-bottom: 0.75rem; }
  .sidebar :global(.group + .group) { margin-top: 0.25rem; }
  .sidebar :global(.group > summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .sidebar :global(.group > summary::-webkit-details-marker) { display: none; }
  .sidebar :global(.group > summary:hover) { background: var(--surface); }
  .sidebar :global(.group > summary:focus-visible) { outline-offset: -2px; }
  .sidebar :global(.group > ul) { padding: 0.125rem 0 0.5rem; }
  .sidebar :global(a) {
    display: flex;
    gap: 0.5rem;
    padding: 0.3125rem 0.625rem;
    border-radius: 8px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .sidebar :global(a:hover) { color: var(--ink); background: var(--surface); }
  .sidebar :global(a[aria-current="page"]) { color: var(--ink); background: var(--surface); box-shadow: inset 0 0 0 1px var(--rule); }
  .sidebar :global(.note) {
    flex: none;
    min-width: 1.25rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .toc { display: none; }
  @media (min-width: 80rem) {
    .toc { display: block; min-width: 0; }
    .toc nav {
      position: sticky;
      top: var(--header);
      max-height: calc(100dvh - var(--header));
      overflow-y: auto;
      padding: 3rem 0;
      scrollbar-width: thin;
    }
  }
  .toc-title { margin-bottom: 0.5rem; font-size: 0.8125rem; font-weight: 600; }
  .toc ol { display: flex; flex-direction: column; list-style: none; padding: 0; border-left: 1px solid var(--rule); }
  .toc a {
    display: block;
    padding: 0.25rem 0 0.25rem 0.75rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover { color: var(--ink); }
  .toc a[data-at] { color: var(--ink); border-left-color: var(--ink); }

  .pager { display: grid; gap: 0.75rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--rule); }
  @media (min-width: 40rem) { .pager { grid-template-columns: 1fr 1fr; } }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .pager-link:hover { border-color: var(--rule-firm); background: var(--surface); }
  .pager-next { text-align: right; }
  .pager-dir { font-size: 0.8125rem; color: var(--muted); }
  .pager-title { font-weight: 500; }
</style>
