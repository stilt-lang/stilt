module std.math

// The transcendental functions of `f64` (std.math). Their results are
// within 4 ulps of the exact value rather than exact (std.math), so the
// examples compare them within a margin, apart from the values the record
// makes exact.

/// `x` raised to the power `y`.
/// ex: (pow(2.0, 0.5) - f64.sqrt(2.0)).abs() < 1e-12
/// ex: pow(f64.NAN, 0.0) == 1.0
pub fn pow(x: f64, y: f64) -> f64 = ?

/// `e` raised to the power `x`.
/// ex: (exp(1.0) - f64.E).abs() < 1e-12
/// ex: exp(0.0) == 1.0
pub fn exp(x: f64) -> f64 = ?

/// The natural logarithm of `x`.
/// ex: (log(f64.E) - 1.0).abs() < 1e-12
/// ex: log(0.0) == -f64.INFINITY
pub fn log(x: f64) -> f64 = ?

/// The base-2 logarithm of `x`.
/// ex: (log2(8.0) - 3.0).abs() < 1e-12
pub fn log2(x: f64) -> f64 = ?

/// The base-10 logarithm of `x`.
/// ex: (log10(1000.0) - 3.0).abs() < 1e-12
pub fn log10(x: f64) -> f64 = ?

/// The sine of `x`, in radians.
/// ex: (sin(f64.PI / 2.0) - 1.0).abs() < 1e-12
pub fn sin(x: f64) -> f64 = ?

/// The cosine of `x`, in radians.
/// ex: (cos(f64.PI) + 1.0).abs() < 1e-12
/// ex: cos(0.0) == 1.0
pub fn cos(x: f64) -> f64 = ?

/// The tangent of `x`, in radians.
/// ex: (tan(f64.PI / 4.0) - 1.0).abs() < 1e-12
pub fn tan(x: f64) -> f64 = ?

/// The arcsine of `x`, in radians from `-π/2` to `π/2`.
/// ex: (asin(1.0) - f64.PI / 2.0).abs() < 1e-12
pub fn asin(x: f64) -> f64 = ?

/// The arccosine of `x`, in radians from 0 to `π`.
/// ex: (acos(-1.0) - f64.PI).abs() < 1e-12
pub fn acos(x: f64) -> f64 = ?

/// The arctangent of `x`, in radians from `-π/2` to `π/2`.
/// ex: (atan(1.0) - f64.PI / 4.0).abs() < 1e-12
pub fn atan(x: f64) -> f64 = ?

/// The angle of the point `(x, y)` from the positive `x` axis, in radians
/// from `-π` to `π`.
/// ex: (atan2(1.0, -1.0) - 3.0 * f64.PI / 4.0).abs() < 1e-12
pub fn atan2(y: f64, x: f64) -> f64 = ?

/// The hyperbolic sine of `x`.
/// ex: (sinh(1.0) - (f64.E - 1.0 / f64.E) / 2.0).abs() < 1e-12
pub fn sinh(x: f64) -> f64 = ?

/// The hyperbolic cosine of `x`.
/// ex: (cosh(1.0) - (f64.E + 1.0 / f64.E) / 2.0).abs() < 1e-12
pub fn cosh(x: f64) -> f64 = ?

/// The hyperbolic tangent of `x`.
/// ex: (tanh(0.5) - sinh(0.5) / cosh(0.5)).abs() < 1e-12
pub fn tanh(x: f64) -> f64 = ?

/// The cube root of `x`.
/// ex: (cbrt(-27.0) + 3.0).abs() < 1e-12
pub fn cbrt(x: f64) -> f64 = ?

/// `sqrt(x * x + y * y)`, without overflow or underflow in between.
/// ex: (hypot(3.0, 4.0) - 5.0).abs() < 1e-12
/// ex: hypot(f64.INFINITY, f64.NAN) == f64.INFINITY
pub fn hypot(x: f64, y: f64) -> f64 = ?
