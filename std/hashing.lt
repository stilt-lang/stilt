module std.hashing

// Hashes of bytes (std.hashing): SHA-256, its HMAC, and FNV-1a, a fast hash
// that no cryptography relies on. Everything here is written in Stilt.

/// The SHA-256 hash of `bytes`, as FIPS 180-4 defines it: 32 bytes.
/// ex: sha256([]).len() == 32 && sha256([]).take(4) == [227, 176, 196, 66]
/// ex: sha256("abc".bytes()).take(4) == [186, 120, 22, 191]
pub fn sha256(bytes: List<u8>) -> List<u8> {
  var h: List<u32> = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  let n = bytes.len()
  // The bytes, `0x80`, the zeros that end the last block 8 bytes short, and the
  // length in bits in those 8 bytes, most significant first.
  var data = bytes.concat([128])
  for _ in 0..(55 - n).rem_euclid(64) { data.push(0) }
  let bits = n.wrap_to_u64() *% 8
  for k in 0..8 { data.push((bits >> (56 - 8 * k).wrap_to_u64()).wrap_to_u8()) }
  for block in 0..data.len() / 64 { compress(inout h, data, 64 * block) }
  var out: List<u8> = []
  for x in h {
    out.push((x >> 24).wrap_to_u8())
    out.push((x >> 16).wrap_to_u8())
    out.push((x >> 8).wrap_to_u8())
    out.push(x.wrap_to_u8())
  }
  out
}

/// The HMAC of `message` under `key` with SHA-256, as RFC 2104 defines it: 32
/// bytes.
/// ex: hmac_sha256("key".bytes(), "The quick brown fox jumps over the lazy dog".bytes()).take(4) == [247, 188, 131, 244]
pub fn hmac_sha256(key: List<u8>, message: List<u8>) -> List<u8> {
  var k = if key.len() > 64 { sha256(key) } else { key }
  for _ in k.len()..64 { k.push(0) }
  let inner = sha256(k.map(|b| b ^ 0x36).concat(message))
  sha256(k.map(|b| b ^ 0x5c).concat(inner))
}

/// The 64-bit FNV-1a hash of `bytes`: from its offset basis, each byte combined
/// with `^`, then multiplied by its prime, wrapping.
/// ex: fnv1a([]) == 0xcbf29ce484222325 && fnv1a("a".bytes()) == 0xaf63dc4c8601ec8c
pub fn fnv1a(bytes: List<u8>) -> u64 {
  var h: u64 = 0xcbf29ce484222325
  for b in bytes { h = (h ^ b.to_u64()) *% 0x100000001b3 }
  h
}

// The round constants of SHA-256.
const K: List<u32> = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

// The words of `x` rotated right by `n`, from 1 to 31.
fn rotr(x: u32, n: u32) -> u32 { (x >> n) | (x << (32 - n)) }

// The 64 words of the schedule of the block at offset `at` of `data`.
fn schedule(data: List<u8>, at: i64) -> List<u32> {
  var w: List<u32> = []
  for i in 0..16 {
    var word: u32 = 0
    for k in 0..4 { word = (word << 8) | (data.get(at + 4 * i + k) else 0).to_u32() }
    w.push(word)
  }
  for i in 16..64 {
    let a = w.get(i - 15) else 0
    let b = w.get(i - 2) else 0
    let s0 = rotr(a, 7) ^ rotr(a, 18) ^ (a >> 3)
    let s1 = rotr(b, 17) ^ rotr(b, 19) ^ (b >> 10)
    w.push((w.get(i - 16) else 0) +% s0 +% (w.get(i - 7) else 0) +% s1)
  }
  w
}

// Updates the state `h` with the block at offset `at` of `data`.
fn compress(inout h: List<u32>, data: List<u8>, at: i64) {
  let w = schedule(data, at)
  var v = h
  for i in 0..64 {
    let (a, b, c, d) = (v.get(0) else 0, v.get(1) else 0, v.get(2) else 0, v.get(3) else 0)
    let (e, f, g, hh) = (v.get(4) else 0, v.get(5) else 0, v.get(6) else 0, v.get(7) else 0)
    let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
    let t1 = hh +% s1 +% ((e & f) ^ (!e & g)) +% (K.get(i) else 0) +% (w.get(i) else 0)
    let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
    let t2 = s0 +% ((a & b) ^ (a & c) ^ (b & c))
    v = [t1 +% t2, a, b, c, d +% t1, e, f, g]
  }
  h = h.zip(v).map(|p| p.0 +% p.1)
}
