  /// The `f32` closest to e.
  pub const E: f32 = 2.7182817
  /// A quiet NaN.
  pub const NAN: f32 = ?
  /// Positive infinity.
  pub const INFINITY: f32 = ?
  /// The square root.
  pub fn sqrt(self) -> f32 = ?
  /// The largest integer no greater than `self`.
  pub fn floor(self) -> f32 = ?
  /// The smallest integer no less than `self`.
  pub fn ceil(self) -> f32 = ?
  /// `self` rounded toward zero.
  pub fn trunc(self) -> f32 = ?
  /// `self` rounded to the nearest integer, with halves away from zero.
  pub fn round(self) -> f32 = ?
  /// The absolute value.
  pub fn abs(self) -> f32 = ?
  /// IEEE 754 `minimum`: NaN if either operand is NaN, and `-0.0` is less than `0.0`.
  pub fn min(self, other: f32) -> f32 = ?
  /// IEEE 754 `maximum`: NaN if either operand is NaN, and `-0.0` is less than `0.0`.
  pub fn max(self, other: f32) -> f32 = ?
  /// Whether `self` is NaN.
  pub fn is_nan(self) -> bool = ?
  /// `self` truncated toward zero, as an `i8`, or `None` for NaN, infinities and values out of range.
  pub fn to_i8(self) -> Option<i8> = ?
  /// `self` truncated toward zero, as an `i16`, or `None` for NaN, infinities and values out of range.
  pub fn to_i16(self) -> Option<i16> = ?
  /// `self` truncated toward zero, as an `i32`, or `None` for NaN, infinities and values out of range.
  pub fn to_i32(self) -> Option<i32> = ?
  /// `self` truncated toward zero, as an `i64`, or `None` for NaN, infinities and values out of range.
  pub fn to_i64(self) -> Option<i64> = ?
  /// `self` truncated toward zero, as a `u8`, or `None` for NaN, infinities and values out of range.
  pub fn to_u8(self) -> Option<u8> = ?
  /// `self` truncated toward zero, as a `u16`, or `None` for NaN, infinities and values out of range.
  pub fn to_u16(self) -> Option<u16> = ?
  /// `self` truncated toward zero, as a `u32`, or `None` for NaN, infinities and values out of range.
  pub fn to_u32(self) -> Option<u32> = ?
  /// `self` truncated toward zero, as a `u64`, or `None` for NaN, infinities and values out of range.
  pub fn to_u64(self) -> Option<u64> = ?
  /// `self`.
  pub fn to_f32(self) -> f32 = ?
  /// `self` as an `f64`, exactly.
  pub fn to_f64(self) -> f64 = ?
  /// The largest finite `f32`.
  pub const MAX: f32 = 3.4028235e38
  /// The smallest finite `f32`.
  pub const MIN: f32 = -3.4028235e38
  /// The difference between 1.0 and the next larger `f32`.
  pub const EPSILON: f32 = 1.1920929e-7
  /// The smallest positive normal `f32`.
  pub const MIN_POSITIVE: f32 = 1.1754944e-38
  /// Whether `self` is neither infinite nor NaN.
  pub fn is_finite(self) -> bool { !self.is_nan() && !self.is_infinite() }
  /// Whether `self` is an infinity.
  pub fn is_infinite(self) -> bool { self.abs() == f32.INFINITY }
  /// `self` raised to `lo`, then lowered to `hi`, so NaN stays NaN.
  pub fn clamp(self, lo: f32, hi: f32) -> f32 { self.max(lo).min(hi) }
  /// The sum of the elements of `xs`, added from the first to the last.
  pub fn sum(xs: List<f32>) -> f32 { xs.fold(0.0, |total, x| total + x) }
}

