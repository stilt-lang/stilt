impl i64 {
  /// The smallest `i64`.
  pub const MIN: i64 = -9223372036854775808
  /// The largest `i64`.
  pub const MAX: i64 = 9223372036854775807
  /// The absolute value. Panics with `overflow` for `i64.MIN`.
  /// ex: (-5).abs() == 5
  pub fn abs(self) -> i64 = ?
  /// The smaller of `self` and `other`.
  /// ex: 3.min(7) == 3
  pub fn min(self, other: i64) -> i64 = ?
  /// The larger of `self` and `other`.
  /// ex: 3.max(7) == 7
  pub fn max(self, other: i64) -> i64 = ?
  /// `self` as an `i8`, or `None` if it doesn't fit.
  /// ex: 100.to_i8() == Some(100)
  /// ex: 300.to_i8() == None
  pub fn to_i8(self) -> Option<i8> = ?
  /// `self` as an `i16`, or `None` if it doesn't fit.
  /// ex: 40000.to_i16() == None
  pub fn to_i16(self) -> Option<i16> = ?
  /// `self` as an `i32`, or `None` if it doesn't fit.
  /// ex: (-7).to_i32() == Some(-7)
  pub fn to_i32(self) -> Option<i32> = ?
  /// `self` as an `i64`.
  /// ex: 7.to_i64() == 7
  pub fn to_i64(self) -> i64 = ?
  /// `self` as a `u8`, or `None` if it doesn't fit.
  /// ex: (-1).to_u8() == None
  pub fn to_u8(self) -> Option<u8> = ?
  /// `self` as a `u16`, or `None` if it doesn't fit.
  /// ex: 65535.to_u16() == Some(65535)
  pub fn to_u16(self) -> Option<u16> = ?
  /// `self` as a `u32`, or `None` if it doesn't fit.
  /// ex: (-1).to_u32() == None
  pub fn to_u32(self) -> Option<u32> = ?
  /// `self` as a `u64`, or `None` if it doesn't fit.
  /// ex: 7.to_u64() == Some(7)
  pub fn to_u64(self) -> Option<u64> = ?
  /// `self` as an `f32`, rounded to nearest with ties to even.
  /// ex: 3.to_f32() == 3.0
  pub fn to_f32(self) -> f32 = ?
  /// `self` as an `f64`, rounded to nearest with ties to even.
  /// ex: (-2).to_f64() == -2.0
  pub fn to_f64(self) -> f64 = ?
  /// The low bits of `self`, as an `i8`.
  /// ex: 300.wrap_to_i8() == 44
  pub fn wrap_to_i8(self) -> i8 = ?
  /// The low bits of `self`, as an `i16`.
  /// ex: 70000.wrap_to_i16() == 4464
  pub fn wrap_to_i16(self) -> i16 = ?
  /// The low bits of `self`, as an `i32`.
  /// ex: 4294967297.wrap_to_i32() == 1
  pub fn wrap_to_i32(self) -> i32 = ?
  /// The low bits of `self`, as an `i64`.
  /// ex: (-1).wrap_to_i64() == -1
  pub fn wrap_to_i64(self) -> i64 = ?
  /// The low bits of `self`, as a `u8`.
  /// ex: (-1).wrap_to_u8() == 255
  pub fn wrap_to_u8(self) -> u8 = ?
  /// The low bits of `self`, as a `u16`.
  /// ex: (-1).wrap_to_u16() == 65535
  pub fn wrap_to_u16(self) -> u16 = ?
  /// The low bits of `self`, as a `u32`.
  /// ex: (-1).wrap_to_u32() == 4294967295
  pub fn wrap_to_u32(self) -> u32 = ?
  /// The low bits of `self`, as a `u64`.
  /// ex: (-1).wrap_to_u64() == 18446744073709551615
  pub fn wrap_to_u64(self) -> u64 = ?
  /// `self + other`, or `None` if the sum doesn't fit in `i64`.
  /// ex: 2.checked_add(3) == Some(5)
  /// ex: i64.MAX.checked_add(1) == None
  pub fn checked_add(self, other: i64) -> Option<i64> = ?
  /// `self - other`, or `None` if the difference doesn't fit in `i64`.
  /// ex: i64.MIN.checked_sub(1) == None
  pub fn checked_sub(self, other: i64) -> Option<i64> = ?
  /// `self * other`, or `None` if the product doesn't fit in `i64`.
  /// ex: i64.MAX.checked_mul(2) == None
  pub fn checked_mul(self, other: i64) -> Option<i64> = ?
  /// `self + other`, clamped to `i64.MIN` and `i64.MAX`.
  /// ex: i64.MAX.saturating_add(1) == i64.MAX
  pub fn saturating_add(self, other: i64) -> i64 = ?
  /// `self - other`, clamped to `i64.MIN` and `i64.MAX`.
  /// ex: i64.MIN.saturating_sub(1) == i64.MIN
  pub fn saturating_sub(self, other: i64) -> i64 = ?
  /// `self` raised to `exp`. Panics with `overflow` if the result doesn't fit.
  /// ex: 2.pow(10) == 1024
  /// ex: (-3).pow(3) == -27
  pub fn pow(self, exp: u32) -> i64 = ?
  /// The quotient of Euclidean division, whose remainder is never negative.
  /// Panics with `divide-by-zero` when `other` is 0.
  /// ex: (-7).div_euclid(2) == -4
  pub fn div_euclid(self, other: i64) -> i64 = ?
  /// The remainder of Euclidean division, which is never negative. Panics
  /// with `divide-by-zero` when `other` is 0.
  /// ex: (-7).rem_euclid(2) == 1
  pub fn rem_euclid(self, other: i64) -> i64 = ?
  /// The number of 1 bits.
  /// ex: 7.count_ones() == 3
  pub fn count_ones(self) -> i64 = ?
  /// The number of 0 bits before the highest 1 bit.
  /// ex: 1.leading_zeros() == 63
  pub fn leading_zeros(self) -> i64 = ?
  /// The number of 0 bits after the lowest 1 bit.
  /// ex: 8.trailing_zeros() == 3
  pub fn trailing_zeros(self) -> i64 = ?
  /// The greatest common divisor of the absolute values, never negative.
  /// ex: 12.gcd(-18) == 6
  pub fn gcd(self, other: i64) -> i64 = ?
  /// The least common multiple of the absolute values, or 0 if either is 0.
  /// ex: 4.lcm(6) == 12
  pub fn lcm(self, other: i64) -> i64 = ?
  /// `self` raised to `lo`, then lowered to `hi`.
  /// ex: 15.clamp(0, 10) == 10
  pub fn clamp(self, lo: i64, hi: i64) -> i64 { self.max(lo).min(hi) }
  /// The sum of the elements of `xs`. Panics with `overflow` as `+` does.
  /// ex: i64.sum([1, 2, 3]) == 6
  pub fn sum(xs: List<i64>) -> i64 { xs.fold(0, |total, x| total + x) }
}

