module std.prelude

// The prelude (program.contents), and the methods of the built-in types
// (std.method-names). The built-in types have no declarations: this module is their
// home, so their impl blocks are here. A body or value written `?` is native
// (see README.md).

use std.c

/// An optional value.
pub type Option<T> = | None | Some(T)

/// The result of an operation that can fail, kept as data.
pub type Result<T, E> = | Ok(T) | Err(E)

/// The result of a comparison.
pub type Ordering = | Less | Equal | Greater

/// Equality, behind `==` and `!=`.
pub trait Eq {
  fn eq(self, other: Self) -> bool
}

/// A total order, behind `<`, `<=`, `>` and `>=`.
pub trait Ord {
  fn compare(self, other: Self) -> Ordering
}

/// Hashing, for map keys.
pub trait Hash {
  fn hash(self) -> u64
}

/// Text for people to read, behind interpolation.
pub trait Show {
  /// The text of `self` on its own.
  fn show(self) -> str
  /// The text of `self` inside another value, such as a list.
  fn show_nested(self) -> str { self.show() }
}

/// Writes `s` and a newline to stdout.
pub fn print(s: str) / io = ?

/// Writes `s` and a newline to stderr.
pub fn eprint(s: str) / io = ?

/// Panics with the kind `explicit`, with `msg` quoted and escaped as its detail.
pub fn panic(msg: str) -> Never = ?

/// Panics with the kind `unreachable`.
pub fn unreachable() -> Never = ?

// Panics with the kind `unwrap`, with `detail` as its detail, for `unwrap`.
fn unwrap_failed(detail: str) -> Never = ?

// Panics with the kind `unwrap`, with `msg` quoted and escaped as its detail,
// for `expect`.
fn expect_failed(msg: str) -> Never = ?

/// Flushes both output streams and ends the process with status `code`.
pub fn exit(code: u8) -> Never / io = ?

impl i8 {
  /// The smallest `i8`.
  pub const MIN: i8 = -128
  /// The largest `i8`.
  pub const MAX: i8 = 127
  /// The absolute value. Panics with `overflow` for `i8.MIN`.
  pub fn abs(self) -> i8 = ?
  /// The smaller of `self` and `other`.
  pub fn min(self, other: i8) -> i8 = ?
  /// The larger of `self` and `other`.
  pub fn max(self, other: i8) -> i8 = ?
  /// `self` as an `i8`.
  pub fn to_i8(self) -> i8 = ?
  /// `self` as an `i16`.
  pub fn to_i16(self) -> i16 = ?
  /// `self` as an `i32`.
  pub fn to_i32(self) -> i32 = ?
  /// `self` as an `i64`.
  pub fn to_i64(self) -> i64 = ?
  /// `self` as a `u8`, or `None` if it doesn't fit.
  pub fn to_u8(self) -> Option<u8> = ?
  /// `self` as a `u16`, or `None` if it doesn't fit.
  pub fn to_u16(self) -> Option<u16> = ?
  /// `self` as a `u32`, or `None` if it doesn't fit.
  pub fn to_u32(self) -> Option<u32> = ?
  /// `self` as a `u64`, or `None` if it doesn't fit.
  pub fn to_u64(self) -> Option<u64> = ?
  /// `self` as an `f32`, rounded to nearest with ties to even.
  pub fn to_f32(self) -> f32 = ?
  /// `self` as an `f64`, rounded to nearest with ties to even.
  pub fn to_f64(self) -> f64 = ?
  /// The low bits of `self`, as an `i8`.
  pub fn wrap_to_i8(self) -> i8 = ?
  /// The low bits of `self`, as an `i16`.
  pub fn wrap_to_i16(self) -> i16 = ?
  /// The low bits of `self`, as an `i32`.
  pub fn wrap_to_i32(self) -> i32 = ?
  /// The low bits of `self`, as an `i64`.
  pub fn wrap_to_i64(self) -> i64 = ?
  /// The low bits of `self`, as a `u8`.
  pub fn wrap_to_u8(self) -> u8 = ?
  /// The low bits of `self`, as a `u16`.
  pub fn wrap_to_u16(self) -> u16 = ?
  /// The low bits of `self`, as a `u32`.
  pub fn wrap_to_u32(self) -> u32 = ?
  /// The low bits of `self`, as a `u64`.
  pub fn wrap_to_u64(self) -> u64 = ?
  /// `self + other`, or `None` if the sum doesn't fit in `i8`.
  pub fn checked_add(self, other: i8) -> Option<i8> = ?
  /// `self - other`, or `None` if the difference doesn't fit in `i8`.
  pub fn checked_sub(self, other: i8) -> Option<i8> = ?
  /// `self * other`, or `None` if the product doesn't fit in `i8`.
  pub fn checked_mul(self, other: i8) -> Option<i8> = ?
  /// `self + other`, clamped to `i8.MIN` and `i8.MAX`.
  pub fn saturating_add(self, other: i8) -> i8 = ?
  /// `self - other`, clamped to `i8.MIN` and `i8.MAX`.
  pub fn saturating_sub(self, other: i8) -> i8 = ?
  /// `self` raised to `exp`. Panics with `overflow` if the result doesn't fit.
  pub fn pow(self, exp: u32) -> i8 = ?
  /// The quotient of Euclidean division, whose remainder is never negative.
  /// Panics with `divide-by-zero` when `other` is 0.
  pub fn div_euclid(self, other: i8) -> i8 = ?
  /// The remainder of Euclidean division, which is never negative. Panics
  /// with `divide-by-zero` when `other` is 0.
  pub fn rem_euclid(self, other: i8) -> i8 = ?
  /// The number of 1 bits.
  pub fn count_ones(self) -> i64 = ?
  /// The number of 0 bits before the highest 1 bit.
  pub fn leading_zeros(self) -> i64 = ?
  /// The number of 0 bits after the lowest 1 bit.
  pub fn trailing_zeros(self) -> i64 = ?
  /// The greatest common divisor of the absolute values, never negative.
  pub fn gcd(self, other: i8) -> i8 = ?
  /// The least common multiple of the absolute values, or 0 if either is 0.
  pub fn lcm(self, other: i8) -> i8 = ?
  /// `self` raised to `lo`, then lowered to `hi`.
  pub fn clamp(self, lo: i8, hi: i8) -> i8 { self.max(lo).min(hi) }
  /// The sum of the elements of `xs`. Panics with `overflow` as `+` does.
  pub fn sum(xs: List<i8>) -> i8 { xs.fold(0, |total, x| total + x) }
}

