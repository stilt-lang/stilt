module std.view

// Views into strings and lists, and lazy iterators over them (views.std-view). A view
// is a window into part of a value that someone else owns; an iterator asks
// its sources for elements only when a consumer reads them. Neither can be
// stored, and neither outlives what it looks into: the law of exclusivity
// keeps a source from changing while a view of it lives (views.reads-that-last and
// 9). Every function here is native (views.std-view).

/// A window into part of a `str` or a `List`, between two offsets.
pub type View<T> = ?

/// A lazy sequence of values, read from its sources as a consumer asks.
pub type Iter<T> = ?

impl<T> View<T> {
  /// The part of `source` from `start` up to `end`, counted as `slice`
  /// counts: bytes of a `str`, elements of a list.
  /// ex: View.of("to be", 0, 2).copy() == "to"
  /// ex: View.of([1, 2, 3], 1, 3).copy() == [2, 3]
  pub fn of(source: T, start: i64, end: i64) -> View<T> = ?

  /// The whole of `source`.
  /// ex: View.all([1, 2]).len() == 2
  pub fn all(source: T) -> View<T> = ?

  /// The length of the viewed part.
  /// ex: View.of("to be", 3, 5).len() == 2
  pub fn len(self) -> i64 = ?

  /// Whether the viewed part is empty.
  /// ex: View.of([1], 1, 1).is_empty()
  pub fn is_empty(self) -> bool = ?

  /// The part of the view from `start` up to `end`, counted from its start.
  /// ex: View.of("to be or", 3, 8).view(0, 2).copy() == "be"
  pub fn view(self, start: i64, end: i64) -> View<T> = ?

  /// The viewed part as a value of its own.
  /// ex: View.of([1, 2, 3], 0, 2).copy() == [1, 2]
  /// ex: View.all("ab").copy() == "ab"
  pub fn copy(self) -> T = ?
}

/// The element at `i` of a view of a list, and `None` outside it.
/// ex: get(View.of([1, 2, 3], 1, 3), 0) == Some(2)
/// ex: get(View.all([1]), 1) == None
pub fn get<U>(v: View<List<U>>, i: i64) -> Option<U> = ?

/// A writable view of the part of `xs` from `start` up to `end` (projections.writable-views): bound
/// by `var`, it writes `xs` for its scope, and `v[i]` is a place.
/// ex: { var xs = [1, 2, 3]; { var v = into(inout xs, 0, 2); v[1] = 9 }; xs == [1, 9, 3] }
/// ex: { var xs = [1, 2, 3]; let w = into(inout xs, 1, 3); w.copy() == [2, 3] }
pub fn into<U>(inout xs: List<U>, start: i64, end: i64) -> View<List<U>> = ?

/// A writable view of the part of a writable view, with offsets counted from its start.
/// ex: { var xs = [1, 2, 3]; { var v = into(inout xs, 1, 3); var p = part(inout v, 1, 2); p[0] = 9 }; xs == [1, 2, 9] }
pub fn part<U>(inout v: View<List<U>>, start: i64, end: i64) -> View<List<U>> = ?

/// Calls `f` once with the parts of `xs` before and from `at`, each writable; `f`'s effects
/// pass through.
/// ex: { var xs = [1, 2, 3]; split(inout xs, 1, |inout a, inout b| { a[0] = 9; b[0] = 8 }); xs == [9, 8, 3] }
pub fn split<U>(inout xs: List<U>, at: i64, f: fn(inout View<List<U>>, inout View<List<U>>)) = ?

/// The Unicode scalar values of a view of a string, each as a `str`.
/// ex: chars(View.all("héé")).count() == 3
pub fn chars(v: View<str>) -> Iter<str> = ?

/// The bytes of a view of a string.
/// ex: bytes(View.of("abc", 1, 3)).collect() == [98, 99]
pub fn bytes(v: View<str>) -> Iter<u8> = ?

/// The integers from `start` up to but excluding `end`.
/// ex: range(1, 4).collect() == [1, 2, 3]
/// ex: range(3, 1).count() == 0
pub fn range(start: i64, end: i64) -> Iter<i64> = ?

/// The entries of `m`, in insertion order.
/// ex: { var m = Map.new(); m["a"] = 1; of_map(m).collect() == [("a", 1)] }
pub fn of_map<K: Eq + Hash, V>(m: Map<K, V>) -> Iter<(K, V)> = ?

impl<T> Iter<T> {
  /// The elements of `xs`, in order.
  /// ex: Iter.of([1, 2]).collect() == [1, 2]
  pub fn of(xs: List<T>) -> Iter<T> = ?

  /// The elements of a view of a list, in order.
  /// ex: Iter.of_view(View.of([1, 2, 3], 1, 3)).collect() == [2, 3]
  pub fn of_view(v: View<List<T>>) -> Iter<T> = ?

  /// Each element, passed through `f` when a consumer asks for it.
  /// ex: Iter.of([1, 2]).map(|x| x * 10).collect() == [10, 20]
  pub fn map<U>(self, escaping f: fn(T) -> U) -> Iter<U> = ?

  /// The elements that `keep` accepts.
  /// ex: range(0, 6).filter(|x| x % 2 == 0).collect() == [0, 2, 4]
  pub fn filter(self, escaping keep: fn(T) -> bool) -> Iter<T> = ?

  /// The first `n` elements, or all of them when there are fewer.
  /// ex: range(0, 10).take(3).collect() == [0, 1, 2]
  pub fn take(self, n: i64) -> Iter<T> = ?

  /// The elements after the first `n`.
  /// ex: range(0, 5).skip(3).collect() == [3, 4]
  pub fn skip(self, n: i64) -> Iter<T> = ?

  /// The elements before the first that `p` rejects.
  /// ex: Iter.of([1, 2, 5, 1]).take_while(|x| x < 3).collect() == [1, 2]
  pub fn take_while(self, escaping p: fn(T) -> bool) -> Iter<T> = ?

  /// The elements from the first that `p` rejects.
  /// ex: Iter.of([1, 2, 5, 1]).skip_while(|x| x < 3).collect() == [5, 1]
  pub fn skip_while(self, escaping p: fn(T) -> bool) -> Iter<T> = ?

  /// Each element paired with its index, counting from `start`.
  /// ex: Iter.of(["a", "b"]).enumerate(1).collect() == [(1, "a"), (2, "b")]
  pub fn enumerate(self, start: i64) -> Iter<(i64, T)> = ?

  /// The pairs of elements of both iterators, ending with the shorter.
  /// ex: Iter.of([1, 2, 3]).zip(Iter.of(["a", "b"])).collect() == [(1, "a"), (2, "b")]
  pub fn zip<U>(self, other: Iter<U>) -> Iter<(T, U)> = ?

  /// The elements of this iterator, then those of `other`.
  /// ex: Iter.of([1]).chain(Iter.of([2, 3])).collect() == [1, 2, 3]
  pub fn chain(self, other: Iter<T>) -> Iter<T> = ?

  /// Every element, in a list.
  /// ex: range(0, 3).collect() == [0, 1, 2]
  pub fn collect(self) -> List<T> = ?

  /// `f` applied to `init` and each element in turn.
  /// ex: Iter.of([1, 2, 3]).fold(0, |s, x| s + x) == 6
  pub fn fold<A>(self, init: A, f: fn(A, T) -> A) -> A = ?

  /// The number of elements.
  /// ex: Iter.of([4, 5]).count() == 2
  pub fn count(self) -> i64 = ?

  /// Whether `p` accepts some element; stops at the first it accepts.
  /// ex: Iter.of([1, 2]).any(|x| x == 2)
  pub fn any(self, p: fn(T) -> bool) -> bool = ?

  /// Whether `p` accepts every element; stops at the first it rejects.
  /// ex: !Iter.of([1, 2]).all(|x| x == 2)
  pub fn all(self, p: fn(T) -> bool) -> bool = ?

  /// The first element that `p` accepts.
  /// ex: Iter.of([1, 2, 3]).find(|x| x > 1) == Some(2)
  pub fn find(self, p: fn(T) -> bool) -> Option<T> = ?

  /// The first element.
  /// ex: range(2, 5).first() == Some(2)
  /// ex: range(2, 2).first() == None
  pub fn first(self) -> Option<T> = ?

  /// The last element.
  /// ex: range(2, 5).last() == Some(4)
  pub fn last(self) -> Option<T> = ?

  /// The element at `n`, counting from 0.
  /// ex: range(2, 5).nth(1) == Some(3)
  pub fn nth(self, n: i64) -> Option<T> = ?
}

impl<T: Ord> Iter<T> {
  /// The greatest element, the first of equal ones.
  /// ex: Iter.of([1, 3, 2]).max() == Some(3)
  pub fn max(self) -> Option<T> = ?

  /// The least element, the first of equal ones.
  /// ex: Iter.of([2, 1, 3]).min() == Some(1)
  pub fn min(self) -> Option<T> = ?
}
