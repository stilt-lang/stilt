module std.text

// Unicode's case mappings and properties of characters (std.text), for each scalar value of a
// text. Everything here is written in Stilt, on the tables at the end of this file, which
// `compiler/stilt-db/tests/unicode_tables.rs` writes from Unicode's data and checks.

/// The version of Unicode whose data this module holds.
/// ex: unicode_version() == "17.0.0"
pub fn unicode_version() -> str { "17.0.0" }

/// `text` with each scalar value replaced by its uppercase, as Unicode's full case mapping gives
/// it without context, so that one may become several.
/// ex: upper("straße") == "STRASSE" && upper("ǆemal 1") == "ǄEMAL 1"
pub fn upper(text: str) -> str { mapped(text, UPPER, (UPPER_MORE, UPPER_TO)) }

/// `text` with each scalar value replaced by its lowercase, as Unicode's full case mapping gives
/// it without context, so that a final `Σ` becomes `σ` too.
/// ex: lower("ΟΔΟΣ Ünï") == "οδοσ ünï" && lower("İ") == "i\u{307}"
pub fn lower(text: str) -> str { mapped(text, LOWER, (LOWER_MORE, LOWER_TO)) }

/// Whether `text` holds a scalar value and each is a letter, of Unicode's property Alphabetic.
/// ex: is_letter("ñandú") && is_letter("漢字") && !is_letter("a1") && !is_letter("")
pub fn is_letter(text: str) -> bool { every(text, ALPHABETIC) }

/// Whether `text` holds a scalar value and each is uppercase, of Unicode's property Uppercase.
/// ex: is_upper("ÉTÉ") && !is_upper("Été")
pub fn is_upper(text: str) -> bool { every(text, UPPERCASE) }

/// Whether `text` holds a scalar value and each is lowercase, of Unicode's property Lowercase.
/// ex: is_lower("été") && !is_lower("été!")
pub fn is_lower(text: str) -> bool { every(text, LOWERCASE) }

/// Whether `text` holds a scalar value and each is a number, of Unicode's general category
/// `N`: a digit, a letter that stands for a number, or another number.
/// ex: is_numeric("42") && is_numeric("٣Ⅻ½") && !is_numeric("4.2")
pub fn is_numeric(text: str) -> bool { every(text, NUMERIC) }

/// Whether `text` holds a scalar value and each is a letter or a number.
/// ex: is_alphanumeric("route66") && !is_alphanumeric("route 66")
pub fn is_alphanumeric(text: str) -> bool {
  !text.is_empty() &&
    text.code_points().all(|c| within(ALPHABETIC, c.to_i64()) || within(NUMERIC, c.to_i64()))
}

/// Whether `text` holds a scalar value and each is white space, of Unicode's property
/// White_Space.
/// ex: is_whitespace(" \t\n\u{a0}\u{3000}") && !is_whitespace("") && !is_whitespace("\u{200b}")
pub fn is_whitespace(text: str) -> bool { every(text, WHITESPACE) }

fn every(text: str, table: List<i64>) -> bool {
  !text.is_empty() && text.code_points().all(|c| within(table, c.to_i64()))
}

/// Whether a run of a property's `table` holds `x`: each run `first << 22 | (last - first) << 1
/// | step - 1`, in order of `first`.
fn within(table: List<i64>, x: i64) -> bool {
  let at = last_at_most(table, x << 22 | 4194303)
  let r = table.get(at) else return false
  holds(x -% (r >> 22), (r >> 1) & 1048575, r & 1)
}

/// Whether a run holds the scalar value `offset` past its first, the run `span` long with a step
/// of 2 when `odd` is 1.
fn holds(offset: i64, span: i64, odd: i64) -> bool {
  offset >= 0 && offset <= span && (odd == 0 || offset & 1 == 0)
}

/// The index of the last number of `table`, which is in order, that is at most `key`, or -1 if
/// none is.
fn last_at_most(table: List<i64>, key: i64) -> i64 {
  var low = 0
  var high = table.len()
  for _ in 0..24 {
    if low >= high { break }
    let middle = (low +% high) >> 1
    if (table.get(middle) else 0) <= key { low = middle +% 1 } else { high = middle }
  }
  low -% 1
}

/// `text` with each scalar value of `more`'s first list, in order, replaced by the three its
/// second gives, `a << 42 | b << 21 | c`, 0 for none, and each other by `table`, runs of `first << 42 |
/// (last - first) << 22 | (step - 1) << 21 | add + 2^20`, with what the run's scalar values add
/// to become their mapping.
fn mapped(text: str, table: List<i64>, more: (List<i64>, List<i64>)) -> str {
  var out: List<u32> = []
  for c in text.code_points() {
    let x = c.to_i64()
    let at = last_at_most(more.0, x)
    if more.0.get(at) == Some(x) {
      let to = more.1.get(at) else 0
      for y in [to >> 42, (to >> 21) & 2097151, to & 2097151] {
        if y != 0 { out.push(y.to_u32() else c) }
      }
      continue
    }
    let r = table.get(last_at_most(table, x << 42 | 4398046511103)) else 0
    let inside = r != 0 && holds(x -% (r >> 42), (r >> 22) & 1048575, (r >> 21) & 1)
    let add = if inside { (r & 2097151) -% 1048576 } else { 0 }
    out.push((x +% add).to_u32() else c)
  }
  str.from_code_points(out) else text
}

