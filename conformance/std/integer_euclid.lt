//~ rule: std.integers
//~ stdout:
//~ | 3 1 -3 1 -4 1 4 1
//~ | 3 0 -3 0 -3 0 3 0
//~ | 2 1 0 7
//~ | -64 0 -64 1

fn main() / io {
  print("{i64.div_euclid(7, 2)} {i64.rem_euclid(7, 2)} {i64.div_euclid(7, -2)} {i64.rem_euclid(7, -2)} {i64.div_euclid(-7, 2)} {i64.rem_euclid(-7, 2)} {i64.div_euclid(-7, -2)} {i64.rem_euclid(-7, -2)}")
  print("{i64.div_euclid(6, 2)} {i64.rem_euclid(6, 2)} {i64.div_euclid(6, -2)} {i64.rem_euclid(6, -2)} {i64.div_euclid(-6, 2)} {i64.rem_euclid(-6, 2)} {i64.div_euclid(-6, -2)} {i64.rem_euclid(-6, -2)}")
  let a: u8 = 7
  let b: u8 = 3
  print("{a.div_euclid(b)} {a.rem_euclid(b)} {u8.div_euclid(7, 255)} {u8.rem_euclid(7, 255)}")
  let m: i8 = i8.MIN
  print("{m.div_euclid(2)} {m.rem_euclid(2)} {i8.div_euclid(-127, 2)} {i8.rem_euclid(-127, 2)}")
}
