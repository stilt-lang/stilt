//~ rule: program.test-results, std.no-panics-by-default, std.str, std.lists

test "lists accept every index from 0 to len" { //~ PASS
  var xs = [1, 2, 3]
  assert xs[0] == 1
  assert xs[2] == 3
  xs[2] = 4
  xs.insert(3, 5)
  xs.insert(0, 0)
  assert xs == [0, 1, 2, 4, 5]
  assert xs.remove(4) == 5
  assert xs.remove(0) == 0
  assert xs.slice(0, 0) == []
  assert xs.slice(3, 3) == []
  assert xs.slice(0, 3) == [1, 2, 4]
}

test "strings accept every offset from 0 to len" { //~ PASS
  let s = "héllo"
  assert s.slice(0, 0) == ""
  assert s.slice(6, 6) == ""
  assert s.slice(0, 6) == "héllo"
  assert s.slice(1, 3) == "é"
  assert s.slice(3, 3) == ""
}

test "list index at len" { //~ FAIL
  let xs = [1, 2, 3]
  let _ = xs[3]
}

test "list index below 0" { //~ FAIL
  let xs = [1, 2, 3]
  let _ = xs[-1]
}

test "list store at len" { //~ FAIL
  var xs = [1, 2, 3]
  xs[3] = 4
}

test "list store below 0" { //~ FAIL
  var xs = [1, 2, 3]
  xs[-1] = 4
}

test "list insert past len" { //~ FAIL
  var xs = [1, 2, 3]
  xs.insert(4, 0)
}

test "list insert below 0" { //~ FAIL
  var xs = [1, 2, 3]
  xs.insert(-1, 0)
}

test "list remove at len" { //~ FAIL
  var xs = [1, 2, 3]
  let _ = xs.remove(3)
}

test "list remove below 0" { //~ FAIL
  var xs = [1, 2, 3]
  let _ = xs.remove(-1)
}

test "list remove from an empty list" { //~ FAIL
  var xs: List<i64> = []
  let _ = xs.remove(0)
}

test "list slice past len" { //~ FAIL
  let xs = [1, 2, 3]
  let _ = xs.slice(2, 4)
}

test "list slice below 0" { //~ FAIL
  let xs = [1, 2, 3]
  let _ = xs.slice(-1, 2)
}

test "list slice with start after end" { //~ FAIL
  let xs = [1, 2, 3]
  let _ = xs.slice(2, 1)
}

test "string slice past len" { //~ FAIL
  let _ = "abc".slice(1, 4)
}

test "string slice below 0" { //~ FAIL
  let _ = "abc".slice(-1, 2)
}

test "string slice with start after end" { //~ FAIL
  let _ = "abc".slice(2, 1)
}

test "string slice starting inside a character" { //~ FAIL
  let _ = "héllo".slice(2, 3)
}

test "string slice ending inside a character" { //~ FAIL
  let _ = "😀".slice(0, 3)
}
