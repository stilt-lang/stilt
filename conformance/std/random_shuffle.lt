//~ rule: std.shuffling
//~ stdout:
//~ | [4, 6, 1, 3, 2, 5] [4, 6, 1, 3, 2, 5] true
//~ | [] [7]

use std.random

// `shuffle` puts a list in the order that `shuffled` returns from the same seed, and draws
// what it draws.
fn main() / io {
  var a = random.Rng.seeded(9)
  var xs = [1, 2, 3, 4, 5, 6]
  a.shuffle(inout xs)
  var b = random.Rng.seeded(9)
  let ys = b.shuffled([1, 2, 3, 4, 5, 6])
  print("{xs} {ys} {a == b}")
  var empty: List<i64> = []
  a.shuffle(inout empty)
  print("{empty} {a.shuffled([7])}")
}
