//~ rule: numbers.format-specs, std.precision
//~ stdout:
//~ | 0.12 0.38 2 4 0 2 2.67 1.00
//~ | 0.10000000000000000555 100000000000000000000.0 0.000 -0.00 -0.0 0.0 3.142 -2 -0
//~ | 0.1000000015 1.0000000 0.30000001192092895508 0.000
//~ | 123.5 1000.0 10 10 0.1 0.1 0.2 0.3

fn main() / io {
  print("{0.125:.2} {0.375:.2} {2.5:.0} {3.5:.0} {0.5:.0} {1.5:.0} {2.675:.2} {1.005:.2}")
  print("{0.1:.20} {1e20:.1} {1e-7:.3} {-0.001:.2} {-0.0:.1} {0.0:.1} {f64.PI:.3} {-2.5:.0} {-0.5:.0}")
  let tenth: f32 = 0.1
  let fifth: f32 = 0.2
  let one: f32 = 1.0
  print("{tenth:.10} {one:.7} {tenth + fifth:.20} {5e-324:.3}")
  print("{123.456:.1} {999.96:.1} {9.5:.0} {10.5:.0} {0.05:.1} {0.15:.1} {0.25:.1} {0.35:.1}")
}
