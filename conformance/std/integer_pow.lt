//~ rule: std.integers
//~ stdout:
//~ | 1 1 0 1024 -27 81
//~ | -9223372036854775808 4611686018427387904
//~ | 1 -1 1
//~ | 127 -128 255
//~ | 4294967296 None

fn main() / io {
  let zero: i64 = 0
  print("{zero.pow(0)} {i64.MIN.pow(0)} {zero.pow(5)} {i64.pow(2, 10)} {i64.pow(-3, 3)} {i64.pow(-3, 4)}")
  print("{i64.pow(-2, 63)} {i64.pow(2, 62)}")
  let minus: i8 = -1
  print("{i8.pow(1, 4000000000)} {minus.pow(4000000001)} {minus.pow(4000000000)}")
  let a: i8 = 127
  let b: i8 = -2
  let c: u8 = 255
  print("{a.pow(1)} {b.pow(7)} {c.pow(1)}")
  let d: u64 = 2
  print("{d.pow(32)} {d.checked_mul(d.pow(63))}")
}
