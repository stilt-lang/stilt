//~ rule: numbers.float-notation, numbers.format-specs, std.scientific-notation
//~ stdout:
//~ | 1.2345e4 1e0 1e-1 1e100 5e-324 1.7976931348623157e308 -2.5e-3
//~ | 1.23e4 1.24e4 1.24e4 1.22e4 1e4 2e4 2e4 1.0e1
//~ | 0e0 -0e0 0.00e0 -0.0e0 0e0
//~ | 1e-1 1.00000001e-1 3.4028235e38 1.00000000000000005551e-1 1.23000e2

fn main() / io {
  print("{12345.0:e} {1.0:e} {0.1:e} {1e100:e} {5e-324:e} {1.7976931348623157e308:e} {-0.0025:e}")
  print("{12345.0:.2e} {12355.0:.2e} {12350.0:.2e} {12250.0:.2e} {12345.0:.0e} {15000.0:.0e} {25000.0:.0e} {9.99:.1e}")
  print("{0.0:e} {-0.0:e} {0.0:.2e} {-0.0:.1e} {0.0:.0e}")
  let tenth: f32 = 0.1
  let max: f32 = 3.4028235e38
  print("{tenth:e} {tenth:.8e} {max:e} {0.1:.20e} {123.0:.5e}")
}
