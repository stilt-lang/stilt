//~ rule: std.show-names-and-escapes, std.read-line
//~ stdin: "a\n\n é \n\tx\"\\\n\nlast"
//~ stdout:
//~ | ["a"]
//~ | [""]
//~ | [" é "]
//~ | ["\tx\"\\"]
//~ | [""]
//~ | ["last"]
//~ | None None

use std.io

fn main() / io {
  loop {
    let line = io.read_line() else break
    print("{[line]}")
  }
  print("{io.read_line()} {io.read_line()}")
}
