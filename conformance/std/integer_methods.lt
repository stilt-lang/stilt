//~ rule: numbers.printing-integers, numbers.printing-floats, std.integers
//~ stdout:
//~ | 5 5 127 0 255 9223372036854775807
//~ | -3 7 -128 127 0 255 -1 -1
//~ | 3.141592653589793 2.718281828459045 3.1415927 2.7182817 nan inf -inf true

fn main() / io {
  let a = -5
  let b: i8 = -127
  let c: u8 = 255
  let d = i64.MIN + 1
  print("{a.abs()} {(5).abs()} {b.abs()} {(0).abs()} {c.abs()} {d.abs()}")
  let e: u8 = 0
  let f: i16 = -1
  print("{(-3).min(7)} {(-3).max(7)} {i8.MIN.min(i8.MAX)} {i8.MIN.max(i8.MAX)} {e.min(c)} {e.max(c)} {f.min(f)} {f.max(f)}")
  print("{f64.PI} {f64.E} {f32.PI} {f32.E} {f64.NAN} {f64.INFINITY} {-f32.INFINITY} {f32.NAN.is_nan()}")
}
