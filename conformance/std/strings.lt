//~ rule: std.bytes-and-scalars, std.str, std.str-search, std.str-splitting, std.str-building, std.show-names-and-escapes
//~ stdout:
//~ | ["a", "", "b"] [""] ["h", "é", "j"] ["a", "b"] [] ["x", ""]
//~ | [a b] bbb xa -a-b- -
//~ | 6 ["h", "é", "l", "l", "o"] [104, 195, 169] àBC Àbc a, b
//~ | Some(2) Some(0) None true el true false

fn main() / io {
  print("{"a,,b".split(",")} {"".split(",")} {"héj".split("")} {"a\r\nb\n".lines()} {"".lines()} {"x\n\n".lines()}")
  print("[{" \t a b\n".trim()}] {"aaa".replace("a", "b")} {"aaa".replace("aa", "x")} {"ab".replace("", "-")} {"".replace("", "-")}")
  print("{"héllo".len()} {"héllo".chars()} {"hé".bytes()} {"àbC".ascii_upper()} {"ÀbC".ascii_lower()} {", ".join(["a", "b"])}")
  print("{"hello".find("l")} {"hello".find("")} {"hello".find("z")} {"hello".contains("")} {"hello".slice(1, 3)} {"x".starts_with("")} {"x".ends_with("xx")}")
}
