//~ rule: std.floats, std.clamp-and-sum
//~ stdout:
//~ | 10 0 5 3
//~ | 1.0 nan 0.5 2.0
//~ | 0 0.0 0.0 6 0.75
//~ | true false false false
//~ | false true true false
//~ | 1.7976931348623157e308 -1.7976931348623157e308 2.220446049250313e-16 2.2250738585072014e-308
//~ | 3.4028235e38 -3.4028235e38 1.1920929e-7 1.1754944e-38

fn main() / io {
  print("{15.clamp(0, 10)} {(-3).clamp(0, 10)} {5.clamp(0, 10)} {7.clamp(5, 3)}")
  print("{f64.clamp(1.5, 0.0, 1.0)} {f64.NAN.clamp(0.0, 1.0)} {f64.clamp(0.5, 0.0, 1.0)} {f64.clamp(0.5, 3.0, 2.0)}")
  let none: List<i64> = []
  let floats: List<f64> = []
  print("{i64.sum(none)} {f64.sum(floats)} {f64.sum([-0.0])} {i64.sum([1, 2, 3])} {f64.sum([0.5, 0.25])}")
  print("{f64.is_finite(1.0)} {f64.NAN.is_finite()} {f64.INFINITY.is_finite()} {(-f64.INFINITY).is_finite()}")
  print("{f64.is_infinite(1.0)} {f64.INFINITY.is_infinite()} {(-f64.INFINITY).is_infinite()} {f64.NAN.is_infinite()}")
  print("{f64.MAX} {f64.MIN} {f64.EPSILON} {f64.MIN_POSITIVE}")
  print("{f32.MAX} {f32.MIN} {f32.EPSILON} {f32.MIN_POSITIVE}")
}
