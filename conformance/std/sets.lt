//~ rule: std.sets, std.set-impls, std.show-output
//~ stdout:
//~ | Set([]) Set([3, 1]) 2 true false true
//~ | Set(["b", "a", "c"]) [1, 2]
//~ | Set([1, 2, 3]) Set([2, 3]) Set([1]) Set([1, 3])
//~ | true false true true false
//~ | Set([1, 3]) Set([1, 0])
//~ | true true found
//~ | Set(["a\"b"]) [Set([1])]

fn main() / io {
  let none: List<i64> = []
  let s = Set.from_list([3, 1, 3])
  print("{Set.from_list(none)} {s} {s.len()} {s.contains(1)} {s.contains(2)} {Set.from_list(none).is_empty()}")
  var t = Set.from_list(["b", "a"])
  t.insert("a")
  t.insert("c")
  var u = Set.from_list([1, 2, 3])
  u.remove(3)
  u.remove(9)
  print("{t} {u.to_list()}")
  let a = Set.from_list([1, 2])
  let b = Set.from_list([3, 2])
  print("{a.union(b)} {Set.from_list([1, 2, 3]).intersection(b)} {a.difference(b)} {a.symmetric_difference(b)}")
  print("{Set.from_list([1]).is_subset(a)} {a.is_subset(Set.from_list([1]))} {a.is_superset(Set.from_list([2]))} {Set.from_list([1]).is_disjoint(b)} {a.is_disjoint(b)}")
  print("{Set.from_list([1, 2, 3]).filter(|x| x != 2)} {Set.from_list([1, 2, 3]).map(|x| x % 2)}")
  var m = Map.new()
  m[Set.from_list([2, 1])] = "found"
  print("{Set.from_list([1, 2]) == Set.from_list([2, 1])} {Set.from_list([1, 2]).hash() == Set.from_list([2, 1]).hash()} {m[Set.from_list([1, 2])]}")
  print("{Set.from_list(["a\"b"])} {[Set.from_list([1])]}")
}
