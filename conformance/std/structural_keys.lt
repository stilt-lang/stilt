//~ rule: std.finding-keys, traits.structural-impls
//~ stdout:
//~ | 2 c 1 3 false 2
//~ | {Point { x: 1, y: 2 }: "c", Point { x: 2, y: 1 }: "b"} Set([[1, 2], []])

// Records, variants and lists are keys by their structural `Eq` and `Hash`, which compare
// their parts in order.
type Point = { x: i64, y: i64 }

type Shape = | Dot(Point) | Line(Point, Point)

fn main() / io {
  var m: Map<Point, str> = Map.new()
  m[Point { x: 1, y: 2 }] = "a"
  m[Point { x: 2, y: 1 }] = "b"
  m[Point { x: 1, y: 2 }] = "c"
  var s: Map<Shape, i64> = Map.new()
  s[Dot(Point { x: 0, y: 0 })] = 1
  s[Line(Point { x: 0, y: 0 }, Point { x: 1, y: 1 })] = 2
  var l: Map<List<i64>, i64> = Map.new()
  l[[1, 2]] = 3
  l[[1]] = 4
  let seen = Set.from_list([[1, 2], [1, 2], []])
  print("{m.len()} {m[Point { x: 1, y: 2 }]} {s[Dot(Point { x: 0, y: 0 })]} {l[[1, 2]]} {l.contains([2])} {seen.len()}")
  print("{m} {seen}")
}
