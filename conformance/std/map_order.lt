//~ rule: expressions.for-iterables, std.maps, std.show-output
//~ stdout:
//~ | {"c": 1, "a": 2, "b": 3}
//~ | {"c": 1, "a": 20, "b": 3}
//~ | {"c": 1, "b": 3} Some(20) None
//~ | {"c": 1, "b": 3, "a": 4}
//~ | ["c", "b", "a"] [1, 3, 4] [("c", 1), ("b", 3), ("a", 4)]
//~ | c 1
//~ | b 3
//~ | a 4
//~ | 3 false true false 0 true {}

fn main() / io {
  var m = Map.new()
  m.insert("c", 1)
  m["a"] = 2
  m.insert("b", 3)
  print("{m}")
  m.insert("a", 20)
  print("{m}")
  let gone = m.remove("a")
  let missing = m.remove("a")
  print("{m} {gone} {missing}")
  m["a"] = 4
  print("{m}")
  print("{m.keys()} {m.values()} {m.entries()}")
  for (k, v) in m { print("{k} {v}") }
  let empty: Map<str, i64> = Map.new()
  print("{m.len()} {m.is_empty()} {m.contains("b")} {m.contains("z")} {empty.len()} {empty.is_empty()} {empty}")
}
