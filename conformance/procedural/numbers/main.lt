//~ tier: meta
//~ rule: macros.procedural-bodies, macros.running, traits.structural-impls, std.maps, std.sets, views.adapters, std.integers, std.floats, std.math, numbers.conversions, numbers.wrapping-conversions
//~ stdout:
//~ | 7 3 5 81 -9223372036854775808 1 1
//~ | -3 2 -2 1 3 2
//~ | 2 64 63 64 3 64 7
//~ | 6 0 12 0 12
//~ | None Some(2) None Some(12) 9223372036854775807 -9223372036854775808
//~ | None Some(200) 44 255 -56 18446744073709551615 7.0
//~ | 4.0 2.0 3.0 -2.0 3.0 -3.0 3.0 1.0 0.0 true
