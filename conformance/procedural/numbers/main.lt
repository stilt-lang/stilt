//~ | 17
//~ | Day { name: "mon", t: 21C } Some("hot") true false 2
//~ | [(5, 0), (6, 1), (7, 2)] [(0, 10), (1, 11), (2, 12)] [0, 1, 5, 6]
//~ | true false Some(3)

// Every number function of the library, and structured values and iterators, in the bodies of
// macros, which run while the program is built: each gives what a run gives.

meta use tools

fn main() / io {
  print(tools.integers!())
  print(tools.floats!())
  print(tools.transcendentals!())
  print(tools.structures!())
}
