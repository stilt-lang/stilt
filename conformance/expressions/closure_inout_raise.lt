//~ rule: values.inout-arguments, expressions.inout-closure-parameters, expressions.inout-arguments, effects.innermost-catch
//~ run-output: "[0, 1] 1 5"

type Failure = | Boom

fn run(f: fn(inout List<i64>) / raise<Failure>, inout xs: List<i64>) / raise<Failure> {
  try f(inout xs)
}

fn main() / io {
  var xs = [0]
  let r = try {
    run(
      |inout xs| {
        xs.push(1)
        raise Boom
      },
      inout xs,
    )
    0
  }
    catch Boom => 1
  var n = 0
  let g = |inout n: i64| {
    n = 5
    raise Boom
  }
  try g(inout n) catch Boom => ()
  print("{xs} {r} {n}")
}
