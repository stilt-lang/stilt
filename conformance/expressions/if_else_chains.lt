//~ rule: syntax.else-attachment, expressions.else-after-if, expressions.if
//~ run-output: "negative zero positive 1 9"

fn classify(n: i64) -> str { if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" } }

fn pick(c: bool, o: Option<i64>) -> i64 { (if c { o } else { None }) else 9 }

fn main() / io {
  print("{classify(-1)} {classify(0)} {classify(5)} {pick(true, Some(1))} {pick(false, Some(1))}")
}
