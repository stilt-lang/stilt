//~ rule: syntax.expressions, expressions.loops, std.maps
//~ stdout:
//~ | 6
//~ | b=2 c=3 a=4
//~ | 0
//~ | 1
//~ | 2
//~ | [(0, 0), (0, 1), (2, 0), (2, 1)]
//~ | 3

fn main() / io {
  var sum = 0
  for x in [1, 2, 3] { sum += x }
  print("{sum}")
  var m = Map.new()
  m["b"] = 2
  m["a"] = 1
  m["c"] = 3
  let gone = m.remove("a")
  m["a"] = 4
  var parts: List<str> = []
  for (k, v) in m { parts.push("{k}={v}") }
  print(" ".join(parts))
  var count = 0
  while count < 3 {
    print("{count}")
    count += 1
  }
  var pairs = []
  for i in 0..3 {
    if i == 1 { continue }
    for j in 0..3 {
      if j == 2 { break }
      pairs.push((i, j))
    }
  }
  print("{pairs}")
  var n = 0
  loop {
    n += 1
    while true { break }
    if n == 3 { break }
  }
  print("{n}")
}
