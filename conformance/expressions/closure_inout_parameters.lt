//~ rule: syntax.closure-parameters, expressions.inout-closure-parameters, expressions.inout-arguments, declarations.function-types, modes.what-can-be-modified
//~ run-output: "7 1 3 3"

type Body = { x: i64, v: i64 }

fn step(update: fn(inout Body, i64), inout b: Body, dt: i64) { update(inout b, dt) }

fn twice(f: fn(inout i64, inout i64)) -> (i64, i64) {
  var a = 1
  var b = 0
  f(inout a, inout b)
  f(inout a, inout b)
  (a, b)
}

fn main() / io {
  var b = Body { x: 0, v: 2 }
  step(|inout b, dt| { b.x += b.v * dt }, inout b, 3)
  step(
    |inout b: Body, dt: i64| {
      b.v -= 1
      b.x += b.v * dt
    },
    inout b,
    1,
  )
  let (a, c) = twice(|inout a, inout c| {
    c += a
    a += 1
  })
  print("{b.x} {b.v} {a} {c}")
}
