//~ rule: expressions.inout-closure-parameters, expressions.inout-arguments, declarations.function-types, traits.method-resolution
//~ run-output: "13 [1, 2, 1] 26"

type Rule = { weight: i64, apply: fn(inout i64, inout List<i64>) }

fn main() / io {
  let rules = [
    Rule {
      weight: 1,
      apply: |inout n, inout trail| {
        n += 1
        trail.push(1)
      },
    },
    Rule {
      weight: 2,
      apply: |inout n, inout trail: List<i64>| {
        n *= 4
        trail.push(2)
      },
    },
  ]
  var n = 2
  var trail = []
  for r in rules { r.apply(inout n, inout trail) }
  rules[0].apply(inout n, inout trail)
  let doubles: List<fn(inout i64)> = [|inout x| { x *= 2 }]
  var m = n
  doubles[0](inout m)
  print("{n} {trail} {m}")
}
