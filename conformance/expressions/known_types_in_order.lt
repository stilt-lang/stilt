//~ rule: numbers.literal-defaults, types.known-types

fn too_late() -> i64 {
  var xs = []
  let n = xs[0].abs() //~ ERROR E0312
  xs.push(1)
  n
}

fn in_time() -> i64 {
  var xs = []
  xs.push(-1)
  xs[0].abs()
}

fn defaulted() -> f64 {
  let x = 5
  let a = x.abs()
  x //~ ERROR E0311
}

fn widened() -> f64 {
  var total = 0
  total += 1.5
  total
}
