//~ rule: expressions.break-and-continue
//~ run-output: "[1, 1, 3, 3] 3"

fn main() / io {
  var log = []
  for x in [1, 2, 3] { for y in (if x == 2 { continue } else { [x, x] }) { log.push(y) } }
  var n = 0
  var rounds = 0
  loop {
    rounds += 1
    if rounds > 5 {
      print("the break in the head ended only the while")
      return
    }
    while (if n == 3 { break } else { true }) { n += 1 }
  }
  print("{log} {n}")
}
