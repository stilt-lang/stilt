//~ rule: syntax.expressions, expressions.closures, expressions.bar-token, patterns.irrefutable-positions
//~ run-output: "0 2 6 3 3 3 [2, 3]"

type P = { x: i64, y: i64 }

fn apply(f: fn(i64) -> i64, v: i64) -> i64 { f(v) }

fn main() / io {
  let zero = || 0
  let inc = |x: i64| x + 1
  let mul = |a: i64, b: i64| a * b
  let pair = |(a, b): (i64, i64)| a - b
  let sum = |P { x, y }: P| x + y
  let abs = apply(|n| n.abs(), -3)
  let shifted = [1, 2].map(|n| n + 1)
  print("{zero()} {inc(1)} {mul(2, 3)} {pair((5, 2))} {sum(P { x: 1, y: 2 })} {abs} {shifted}")
}
