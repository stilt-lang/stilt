pub fn even(n: i64) -> bool { if n == 0 { true } else { odd(n - 1) } }

pub fn odd(n: i64) -> bool { if n == 0 { false } else { even(n - 1) } }

pub fn a(xs: List<i64>, n: i64) -> i64 { if n == 0 { 0 } else { b(xs, n - 1) } }

fn b(xs: List<i64>, n: i64) -> i64 { c(xs, n) + 1 }

fn c(xs: List<i64>, n: i64) -> i64 { if n == 1 { xs[n] } else { a(xs, n) } }

pub fn countdown(n: i64) -> i64 { if n <= 0 { 0 } else { countdown(n - 1) } }
