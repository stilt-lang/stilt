module pure
without panic

use lib

pub fn sum_lengths(a: List<i64>, b: List<i64>) -> i64 { lib.length(a) + lib.length(b) }

pub fn shifted(xs: List<i64>) -> List<i64> { xs.map(|x| x + 1) }

pub fn ordered(xs: List<lib.Sturdy>) -> List<lib.Sturdy> { xs.sorted() }

pub fn parity(n: i64) -> bool { lib.even(n) }

pub fn apply(f: fn(i64) -> i64, x: i64) -> i64 { lib.twice(f, x) }

pub fn halve(n: i64) -> i64 { n / 2 }
