pub type Sturdy = { n: i64 }

pub fn length(xs: List<i64>) -> i64 { xs.len() }

pub fn even(n: i64) -> bool { if n == 0 { true } else { odd(n - 1) } }

pub fn odd(n: i64) -> bool { if n == 0 { false } else { even(n - 1) } }

pub fn twice(f: fn(i64) -> i64, x: i64) -> i64 { f(f(x)) }

pub fn divider() -> fn(i64) -> i64 { |n| 100 / n }
