//~ rule: declarations.constant-expressions

type Point = { x: i64, y: i64 }

const ORIGIN: Point = Point { x: 0, y: 0 }
const LIMIT: i64 = -100
const MARKS: List<(Point, Option<str>)> = [(ORIGIN, Some("origin")), (Point { x: -1, y: 1 }, None)]

impl Point {
  const UNIT: Point = Point { x: 1, y: 1 }
  const DIAGONAL: (Point, Point) = (ORIGIN, Point.UNIT)
}

fn width() -> i64 { 10 }

const WIDTH: i64 = width() //~ ERROR E0326
const TITLE: str = "limit {LIMIT}" //~ ERROR E0326
const X: i64 = ORIGIN.x //~ ERROR E0326
