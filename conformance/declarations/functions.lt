//~ rule: syntax.declarations, declarations.function-declarations, declarations.methods, traits.methods, effects.non-escaping-parameters
//~ stdout:
//~ | 2
//~ | 9
//~ | 1
//~ | 2
//~ | [0, 1]
//~ | 2

type Counter = { count: i64 }

impl Counter {
  pub fn get(self) -> i64 { self.count }

  pub fn bump(inout self) { self.count += 1 }

  pub fn finish(self) -> i64 { self.count }
}

fn largest<T: Ord + Show>(xs: List<T>, first: T) -> str {
  var best = first
  for x in xs { if x > best { best = x } }
  "{best}"
}

fn each(xs: List<i64>, f: fn(i64)) { for x in xs { f(x) } }

fn add_one(inout xs: List<i64>) { xs.push(1) }

fn later(x: i64) -> i64 = ? //~ WARN W0300

fn main() / io {
  var c = Counter { count: 0 }
  c.bump()
  c.bump()
  print("{c.get()}")
  print(largest([3, 9, 4], 0))
  each([1, 2], |x| print("{x}"))
  var xs = [0]
  add_one(inout xs)
  print("{xs}")
  print("{c.finish()}")
}
