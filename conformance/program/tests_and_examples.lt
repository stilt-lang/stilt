//~ rule: program.test-results, program.running-tests, program.assert-expr, program.doc-examples, declarations.tests

/// Doubles a number.
/// ex: double(2) == 4 //~ PASS
/// ex: double(2) == 5 //~ FAIL
fn double(x: i64) -> i64 { x * 2 }

type Failure = | Bad

fn fails() / raise<Failure> { raise Bad }

test "asserts" { //~ PASS
  print("tests may print")
  assert double(3) == 6
}

test "panics" { //~ FAIL
  let xs: List<i64> = []
  let _ = xs[1]
}

test "runs after a panic" { //~ PASS
  assert true
}

test "raises" { //~ FAIL
  try fails()
}

test "exits" { //~ FAIL
  exit(0)
}

test "runs after an exit" { //~ PASS
  assert double(0) == 0
}

test "fails an assert" { //~ FAIL
  assert double(1) == 3
}

// A `return` finishes the body.
test "returns early" { //~ PASS
  if double(1) == 2 { return }
  assert false
}
