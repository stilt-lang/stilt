trait Store {
  fn put(self, x: i64) -> str
}

type Shelf = {}

type Both = {}

impl Store for Shelf {
  fn put(self, x: i64) -> str { "number {x}" }
}

// The part of the block breaks before the method's body, so the method is declared with an error.
impl Store for Both {
  fn put(self, x: i64) const -> str { "number {x}" } //~ ERROR E0100
}

fn main() / io {
  print(Shelf {}.put(1))
  print(Store.put(Both {}, 2))
}
