pub type Shape = | Circle(f64) | Square(f64)

pub type Point = { x: f64, y: f64 }

pub trait Area {
  fn area(self) -> f64
}

impl Area for Shape {
  fn area(self) -> f64 {
    match self {
      Circle(r) => r * r
      Square(s) => s * s
    }
  }
}

impl Shape {
  pub const ZERO: f64 = 0.0

  pub fn unit() -> Shape { Circle(1.0) }
}
