//~ rule: values.value-semantics, values.independent-copies, patterns.bindings-are-copies
//~ stdout:
//~ | P { x: 1, y: 2 } P { x: 9, y: 2 }
//~ | (1, "a") (1, "b")
//~ | [1, 2] [1, 2, 3]
//~ | {"a": 1} {"a": 2, "b": 3}
//~ | Box([1]) [1, 4]
//~ | ab abc

type P = { x: i64, y: i64 }
type Box = | Box(List<i64>)

fn main() / io {
  var p = P { x: 1, y: 2 }
  let q = p
  p.x = 9
  print("{q} {p}")
  var t = (1, "a")
  let u = t
  t.1 = "b"
  print("{u} {t}")
  var xs = [1, 2]
  let ys = xs
  xs.push(3)
  print("{ys} {xs}")
  var m = Map.new()
  m["a"] = 1
  let n = m
  m["a"] = 2
  m["b"] = 3
  print("{n} {m}")
  let b = Box([1])
  var Box(items) = b
  items.push(4)
  print("{b} {items}")
  var s = "ab"
  let r = s
  s = "{s}c"
  print("{r} {s}")
}
