//~ rule: values.inout-arguments, values.inout-argument-order, expressions.inout-arguments, effects.innermost-catch
//~ run-output: "[0, 1] 1 2 1"

type Failure = | Boom

fn grow(inout xs: List<i64>) / raise<Failure> {
  xs.push(1)
  raise Boom
}

fn swap(inout a: i64, inout b: i64) {
  let t = a
  a = b
  b = t
}

fn main() / io {
  var xs = [0]
  let r = try {
    grow(inout xs)
    0
  }
    catch Boom => 1
  var a = 1
  var b = 2
  swap(inout a, inout b)
  print("{xs} {r} {a} {b}")
}
