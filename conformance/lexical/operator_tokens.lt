//~ rule: lexical.tokens
//~ stdout:
//~ | 7 3 10 2 1
//~ | 4 251 244
//~ | false true false false true true
//~ | false true false
//~ | 2 7 5 16 16
//~ | 10 244
//~ | 3 3 false 6 251 6

fn main() / io {
  let a = 5
  let b = 2
  let c = 3
  let m: u8 = 250
  print("{a + b} {a - b} {a * b} {a / b} {a % b}")
  print("{m +% 10} {m -% 255} {m *% 2}")
  print("{a == b} {a != b} {a < b} {a <= b} {a > b} {a >= b}")
  print("{true && false} {true || false} {!true}")
  print("{6 & 3} {6 | 3} {6 ^ 3} {1 << 4} {256 >> 4}")
  var x = 100
  x += 1
  x -= 11
  x *= 2
  x /= 4
  x %= 7
  x <<= 4
  x >>= 1
  x &= 12
  x |= 3
  x ^= 1
  var w: u8 = 200
  w +%= 100
  w -%= 50
  w *%= 2
  print("{x} {w}")
  var s = 0
  for i in 1..=3 {
    s += i
  }
  print("{a+-b} {a---b} {a<-b} {c<<2>>1} {m+%1} {s}")
}
