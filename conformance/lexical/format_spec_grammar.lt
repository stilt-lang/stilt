//~ rule: lexical.format-specs
//~ stdout:
//~ | [42   ] [   42] [ 42 ] [  42] [ab   ] [ ab  ]
//~ | [42***] [::42] [>>42] [éé1] [____ff]
//~ | [2.500] [    2.50] [***3.14***]
//~ | [ff] [FF] [10] [101] [1.5e3] [1.500e3] [     1.5e3]

fn main() / io {
  print("[{42:<5}] [{42:>5}] [{42:^4}] [{42:4}] [{"ab":5}] [{"ab":^5}]")
  print("[{42:*<5}] [{42::>4}] [{42:>>4}] [{1:é>3}] [{255:_>6x}]")
  print("[{2.5:.3}] [{2.5:8.2}] [{3.14159:*^10.2}]")
  print("[{255:x}] [{255:X}] [{8:o}] [{5:b}] [{1500.0:e}] [{1500.0:.3e}] [{1500.0:>10.1e}]")
}
