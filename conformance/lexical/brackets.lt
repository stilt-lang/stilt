//~ rule: lexical.inside-brackets, lexical.continuing-expression
//~ stdout:
//~ | 3 [1, 2] true false
//~ | [3, 5]
//~ | 6

fn add(a: i64, b: i64) -> i64 { a + b }

fn main() / io {
  let sum = add(
    1,
    2
  )
  let xs = [
    1,
    2
  ]
  let bigger = (sum
    > 2)
  let shifted = (sum
    >> 4
    == 1)
  print("{sum} {xs} {bigger} {shifted}")
  let doubled = xs.map(|x: i64| {
    let y = x * 2
    y + 1
  })
  print("{doubled}")
  let total = xs.fold(0, |acc: i64, x: i64| {
    let pair = [
      acc,
      x
    ]
    let next = pair[0] + pair[1]
    next
  })
  print("{total + add(1, 2)}")
}
