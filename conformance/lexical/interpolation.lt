//~ rule: lexical.interpolation, lexical.nested-interpolation, syntax.token-classes
//~ stdout:
//~ | 3 ana
//~ | [2, 4] Point { x: 1, y: 2 }
//~ | inner 3 deep
//~ | 5} {x}
//~ | } a:b

type Point = { x: i64, y: i64 }

fn main() / io {
  let name = "ana"
  print("{1 + 2} {name}")
  print("{[1, 2].map(|x: i64| x * 2)} {Point { x: 1, y: 2 }}")
  print("{"inner {1 + 2} {"deep"}"}")
  print("{5}} \{x}")
  print("{"}"} {"a:b"}")
}
