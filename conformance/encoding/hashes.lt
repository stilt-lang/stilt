use std.encoding
use std.hashing

fn hex(bytes: List<u8>) -> str { encoding.to_hex(bytes) }

fn main() / io {
  print(hex(hashing.sha256([])))
  print(hex(hashing.sha256("abc".bytes())))
  print(hex(hashing.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes())))
  print(hex(hashing.sha256("a".repeat(1000).bytes())))
  print("{hashing.sha256("x".repeat(55).bytes()).len()}")
  print(hex(hashing.hmac_sha256("key".bytes(), "The quick brown fox jumps over the lazy dog".bytes())))
  print(hex(hashing.hmac_sha256("Jefe".bytes(), "what do ya want for nothing?".bytes())))
  let long_key = List.repeat(0xaa, 131)
  print(hex(hashing.hmac_sha256(long_key, "Test Using Larger Than Block-Size Key - Hash Key First".bytes())))
  print("{hashing.fnv1a([]):x} {hashing.fnv1a("a".bytes()):x} {hashing.fnv1a("foobar".bytes()):x}")
}
