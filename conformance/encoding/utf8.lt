//~ rule: std.utf8-errors
//~ stdout:
//~ | Ok("hé€😀")
//~ | [Err(Invalid(1)), Err(Invalid(0)), Err(Invalid(0)), Err(Invalid(0)), Err(Invalid(0)), Err(Invalid(0))]
//~ | [Err(Truncated(1)), Err(Truncated(0)), Err(Truncated(2)), Err(Invalid(0))]
//~ | [true, true, true, true, true, true]

use std.encoding

fn read(bytes: List<u8>) -> Result<str, encoding.Utf8Error> { Result.of(|| try encoding.from_utf8(bytes)) }

fn main() / io {
  print("{read("hé€😀".bytes())}")
  print("{[[104, 255, 105], [192, 128], [237, 160, 128], [244, 144, 128, 128], [128], [224, 128, 128]].map(|b| read(b))}")
  print("{[[104, 195], [240, 159, 152], [104, 105, 226, 130], [226, 40, 161]].map(|b| read(b))}")
  let samples = [[104, 105], [255], [195], [226, 130, 172], [240, 159, 152, 128], [237, 159, 191]]
  print("{samples.map(|b| str.from_utf8(b).is_some() == read(b).is_ok())}")
}
