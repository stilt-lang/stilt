//~ rule: traits.methods

fn area(self) -> f64 { //~ ERROR E0215
  0.0
}

type Point = { x: i64 }

impl Point {
  fn origin() -> Self {
    Self { x: self.x } //~ ERROR E0215
  }

  fn moved(self) -> Self { Self { x: self.x + 1 } }
}

fn make() -> Self { //~ ERROR E0215
  Point { x: 0 }
}

trait Cloned {
  fn cloned(self) -> Self
}

impl Cloned for Point {
  fn cloned(self) -> Self { self }
}
