//~ rule: expressions.inout-arguments, traits.qualified-calls
//~ stdout:
//~ | 0 1 3 4 10
//~ | counter 4 counter 4 counter 4
//~ | 5 false Less 2 3

type Counter = { n: i64 }

impl Counter {
  const START: i64 = 10

  fn new() -> Counter { Counter { n: 0 } }

  fn next(self) -> Counter { Counter { n: self.n + 1 } }

  fn bump(inout self) { self.n += 1 }
}

trait Named {
  fn name(self) -> str
}

impl Named for Counter {
  fn name(self) -> str { "counter {self.n}" }
}

fn main() / io {
  let c = Counter.new()
  let d = Counter.next(c)
  var e = d.next()
  e.bump()
  let f = e
  Counter.bump(inout e)
  print("{c.n} {d.n} {f.n} {e.n} {Counter.START}")
  print("{Named.name(e)} {Counter.name(e)} {e.name()}")
  print("{Show.show(5)} {Eq.eq(1, 2)} {Ord.compare("a", "b")} {List.len([1, 2])} {i64.abs(-3)}")
}
