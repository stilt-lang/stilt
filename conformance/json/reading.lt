//~ tier: meta
//~ rule: std.json, std.json-reading, std.json-read-errors, std.json-effects
//~ stdout:
//~ | round trips: true
//~ | Ok(1.0) Ok(1000.0) Ok(1.0)
//~ | Err(Mismatch("$[0]", "i64", "1.0")) Err(Mismatch("$[0]", "i64", "1e3")) Err(Mismatch("$[1]", "u8", "256"))
//~ | Ok(Note { title: "b", size: 2, extra: None })
//~ | Err(Missing("$.title"))
//~ | Err(Mismatch("$[0].Mix", "(i64, bool)", "[1]")) Err(Mismatch("$[0]", "Light", "{\"Off\":[],\"Dim\":[1]}"))
//~ | Err(Mismatch("$[0]", "Light", "\"Dim\"")) Err(Mismatch("$[0]", "Light", "{\"Off\":null}"))
//~ | Ok((None, None)) Ok((Some(Some(1)), None))
//~ | Err(Mismatch("$[0]", "(i64, i64)", "[1,2,3]")) Err(Mismatch("$[1]", "Array<i64, 2>", "[1]"))
//~ | Err(Mismatch("$[0]", "Map<i64, str>", "{\"1\":\"a\"}")) Ok(([(1, "c"), (2, "b")], {"x": 3}))
//~ | Err(Mismatch("$[0].tag", "Tag", "\"bad\""))
//~ | Err(Mismatch("$[0]", "Map<str, i64>", "[\"abcdefghijklmnopqrstuvwxyzabcdefghijkl"))

use std.json
use std.array

type Light = | Off | Dim(i64) | Mix(i64, bool)

type Note = { title: str, size: u8, extra: Option<str> }

// A type that reads JSON its own way, which may raise.
type Tag = { name: str }

impl json.FromJson for Tag {
  fn from_json(v: json.Value) -> Tag / raise<json.Error> {
    match v {
      json.Text(s) if s.starts_with("#") => Tag { name: s.slice(1, s.len()) }
      _ => raise json.Mismatch("$[0].tag", "Tag", json.render(v))
    }
  }
}

type Tagged = { tag: Tag }

// What `from_text` reads of `text`, as a `T`, or the error it raises.
fn read<T>(text: str) -> Result<T, json.Error> {
  Result.of(|| try json.from_text(text))
}

// `from_value(to_value(x))` equals `x` for a value with no impl at any
// depth.
fn round<T: Eq>(x: T) -> bool {
  Result.of(|| try json.from_value(json.to_value(x))) == Ok(x)
}

fn main() / io {
  var m = Map.new()
  m.insert("k", [1, 2])
  var keyed = Map.new()
  keyed.insert(2, "two")
  let a: array.Array<i8, 2> = [-1, 1]
  let missing: Option<str> = None
  let trips = [
    round((-5, u64.MAX, 0.25, 1e21, true, "a\"\\\u{1}é")),
    round((Some(1), missing, (), [Off, Dim(2), Mix(3, false)])),
    round((Set.from_list([3, 1]), m, keyed, a, { b: 1, a: "x" })),
    round(Note { title: "t", size: 2, extra: Some("e") }),
    round((0.1.to_f32(), 1.5e-7.to_f32())),
  ]
  print("round trips: {trips.all(|t| t)}")
  let f1: Result<(f64,), json.Error> = read("[1]")
  let f2: Result<(f64,), json.Error> = read("[1e3]")
  let f3: Result<(f32,), json.Error> = read("[1.0]")
  print("{f1.map(|t| t.0)} {f2.map(|t| t.0)} {f3.map(|t| t.0)}")
  let i1: Result<(i64,), json.Error> = read("[1.0]")
  let i2: Result<(i64,), json.Error> = read("[1e3]")
  let i3: Result<(u8, u8), json.Error> = read("[255, 256]")
  print("{i1} {i2} {i3}")
  // Unknown members are ignored, and of two members of one name the last
  // is read; a missing field of an option type reads as `None`.
  let n1: Result<Note, json.Error> = read("\{\"title\": \"a\", \"other\": [1], \"title\": \"b\", \"size\": 2}")
  print("{n1}")
  let n2: Result<Note, json.Error> = read("\{\"size\": 2}")
  print("{n2}")
  let v1: Result<(Light,), json.Error> = read("[\{\"Mix\": [1]}]")
  let v2: Result<(Light,), json.Error> = read("[\{\"Off\": [], \"Dim\": [1]}]")
  print("{v1} {v2}")
  let v3: Result<(Light,), json.Error> = read("[\"Dim\"]")
  let v4: Result<(Light,), json.Error> = read("[\{\"Off\": null}]")
  print("{v3} {v4}")
  // `Some(None)` and `Some(())` write `null`, which reads as `None`.
  let nested: (Option<Option<i64>>, Option<()>) = (Some(None), Some(()))
  let o1: Result<(Option<Option<i64>>, Option<()>), json.Error> = read(json.to_text(nested))
  let o2: Result<(Option<Option<i64>>, Option<Option<i64>>), json.Error> = read("[1, null]")
  print("{o1} {o2}")
  let t1: Result<((i64, i64),), json.Error> = read("[[1, 2, 3]]")
  let t2: Result<(i64, array.Array<i64, 2>), json.Error> = read("[0, [1]]")
  print("{t1} {t2}")
  // A map whose key type's shape isn't `Str` reads only from an array of
  // pairs, and of equal keys keeps the last value, at the first's position.
  let m1: Result<(Map<i64, str>,), json.Error> = read("[\{\"1\": \"a\"}]")
  let m2: Result<(Map<i64, str>, Map<str, i64>), json.Error> = read("[[[1, \"a\"], [2, \"b\"], [1, \"c\"]], \{\"x\": 1, \"x\": 3}]")
  print("{m1} {m2.map(|p| (p.0.entries(), p.1))}")
  let g: Result<(Tagged,), json.Error> = read("[\{\"tag\": \"bad\"}]")
  print("{g}")
  let long: Result<(Map<str, i64>,), json.Error> = read("[[\"abcdefghijklmnopqrstuvwxyzabcdefghijklmnop\"]]")
  print("{long}")
}
