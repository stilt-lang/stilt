//~ rule: polymorphism.recursion
//~ stdout:
//~ | 2
//~ | 3
//~ | [1, 2] [[3]]

type Nested<T> = | Flat(T) | Nest(Nested<List<T>>)

// `depth` calls itself at `Nested<List<T>>`.
fn depth<T>(n: Nested<T>) -> i64 {
  match n {
    Flat(_) => 0
    Nest(inner) => 1 + depth(inner)
  }
}

// Two functions of one group, each calling the other at a deeper type.
fn even_wrap<T: Show>(x: T, n: i64) -> str {
  if n == 0 { "{x}" } else { odd_wrap([x], n - 1) }
}

fn odd_wrap<T: Show>(x: T, n: i64) -> str {
  if n == 0 { "{x}" } else { even_wrap([x], n - 1) }
}

fn main() / io {
  let n: Nested<i64> = Nest(Nest(Flat([[1, 2]])))
  print("{depth(n)}")
  let m: Nested<str> = Nest(Nest(Nest(Flat([[["a"]]]))))
  print("{depth(m)}")
  print("{even_wrap([1, 2], 0)} {odd_wrap(3, 2)}")
}
