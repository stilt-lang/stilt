//~ tier: advanced
//~ rule: polymorphism.lazy-implicit-effects

use std.lazy

fn table() -> lazy.Lazy<List<i64>> { lazy.Lazy.new(|| [1, 2, 3]) }

// `get` may not end.
fn first(t: lazy.Lazy<List<i64>>) -> i64 without div {
  t.get().len() //~ ERROR E0204
}

// The closure's panic is counted where it is written, in `risky`, so `get` adds none.
fn size(t: lazy.Lazy<List<i64>>) -> i64 without panic { t.get().len() }

fn risky() -> lazy.Lazy<i64> without panic {
  lazy.Lazy.new(|| [1][3]) //~ ERROR E0204
}
