//~ tier: advanced
//~ rule: variadics.packs, errors.root-causes

// A misplaced pack is reported once, where it is declared. A field that then names it without a
// spread reports nothing more, since the pack is a plain type parameter after the error.
type Early<..Ts, U> = { a: (Ts), b: U } //~ ERROR E0344

type Two<..Ts, ..Us> = { a: Ts, b: (..Us) } //~ ERROR E0344
