fn main() / io {
  let tenth: f32 = 0.1
  let fifth: f32 = 0.2
  let one: f32 = 1.0
  print("{tenth} {fifth} {tenth + fifth} {one / 3.0} {f32.PI} {f32.E}")
  let max: f32 = 3.4028235e38
  let normal: f32 = 1.1754944e-38
  let subnormal: f32 = 1.1754942e-38
  let least: f32 = 1e-45
  let a: f32 = 16777216
  let b: f32 = 1e10
  let c: f32 = 1e17
  print("{max} {normal} {subnormal} {least} {a} {b} {c}")
  let d: f32 = 154742504910672534362390528
  let e: f32 = 1237940039285380274899124224
  let f: f32 = 0.000000000000000000000000000012621774483536188886587657044524579674771302961744368076324462890625
  let g: f32 = 170141183460469231731687303715884105728
  let h: f32 = 54837.1875
  print("{d} {e} {f} {g} {h}")
  let below: f32 = 0.99999994
  let above: f32 = 1.0000001
  print("{below} {above} {-tenth} {-least}")
  print("{tenth.to_f64()} {(tenth + fifth).to_f64()}")
}
