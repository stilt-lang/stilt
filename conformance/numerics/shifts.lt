//~ rule: numbers.shifts, numbers.printing-integers
//~ stdout:
//~ | -4 -1 -1 64 -9223372036854775808
//~ | 1 127 1 240 -128 -128 -32768
//~ | 5 5 1 -1 0

fn main() / io {
  let a = -8
  let b = -1
  let c: i8 = -128
  let d = 1
  print("{a >> 1} {b >> 63} {c >> 7} {d << 6} {d << 63}")
  let e: u8 = 128
  let f: u8 = 255
  let g = u64.MAX
  let h: i8 = 1
  let i: i8 = 3
  let j: i16 = -1
  print("{e >> 7} {f >> 1} {g >> 63} {f << 4} {h << 7} {i << 7} {j << 15}")
  let k: u32 = 5
  let l: i32 = -1
  let m: u16 = 1
  print("{k << 0} {k >> 0} {k >> 2} {l >> 31} {m >> 1}")
}
