//~ rule: numbers.integer-panics, std.integers
//~ stdout:
//~ | 127 -128 -1 -127 127 127 -128 0
//~ | 32767 -32768 2147483647 -2147483648 9223372036854775807 -9223372036854775808
//~ | 255 0 65535 4294967295 18446744073709551615 0
//~ | 9223372036854775807 -9223372036854775807 0 -4611686018427387904

fn main() / io {
  let a = i8.MAX
  let b = i8.MIN
  print("{a - 1 + 1} {b + 1 - 1} {a + b} {-a} {-(b + 1)} {(b + 1) / -1} {b / 1} {b % -2}")
  let c = i16.MAX
  let d = i32.MIN
  let e = i64.MAX
  let f = i64.MIN
  print("{c - 1 + 1} {-c - 1} {i32.MAX - 1 + 1} {d + 1 - 1} {e - 1 + 1} {f + 1 - 1}")
  let g = u8.MAX
  let h = u16.MAX
  let i = u32.MAX
  let j = u64.MAX
  print("{g - 1 + 1} {g - g} {h * 1} {i / 1} {j - 0} {j % j}")
  print("{e * 1} {f + 1} {f % 1} {f / 2}")
}
