  assert min + max == -1
  assert max - max == 0
  assert max * 1 == max
  assert min * 1 == min
  assert max * -1 == min + 1
  assert -(min + 1) == max
  assert (min + 1) / -1 == max
  assert min / 1 == min
  assert min % 1 == 0
  assert min % 2 == 0
