//~ rule: numbers.division-and-remainder, numbers.ieee-754
//~ stdout:
//~ | 3 -3 -3 3 1 -1 1 -1
//~ | 0 0 -1 1 -2 -1 28 4
//~ | 1.5 -1.5 1.5 -1.5 -0.0 nan nan 5.5
//~ | 1.5 -1.5

fn main() / io {
  let a = 7
  let b = 2
  print("{a / b} {-a / b} {a / -b} {-a / -b} {a % b} {-a % b} {a % -b} {-a % -b}")
  let c: i8 = -1
  let d: i8 = 2
  let e: i8 = -7
  let f: i8 = 3
  let g: u8 = 200
  let h: u8 = 7
  print("{c / d} {d / -4} {c % d} {-c % -d} {e / f} {e % f} {g / h} {g % h}")
  let x = 5.5
  let y = 2.0
  let zero = 0.0
  let inf = 1.0 / zero
  print("{x % y} {-x % y} {x % -y} {-x % -y} {-0.0 % y} {x % zero} {inf % y} {x % inf}")
  let p: f32 = 5.5
  let q: f32 = -2.0
  print("{p % q} {-p % q}")
}
