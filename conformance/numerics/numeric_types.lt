//~ rule: numbers.numeric-types, numbers.integer-literals, numbers.negative-literals, numbers.printing-integers, std.integers
//~ stdout:
//~ | -128 127 0 255
//~ | -32768 32767 0 65535
//~ | -2147483648 2147483647 0 4294967295
//~ | -9223372036854775808 9223372036854775807 0 18446744073709551615
//~ | 0.5 0.5 0 -7

fn main() / io {
  print("{i8.MIN} {i8.MAX} {u8.MIN} {u8.MAX}")
  print("{i16.MIN} {i16.MAX} {u16.MIN} {u16.MAX}")
  print("{i32.MIN} {i32.MAX} {u32.MIN} {u32.MAX}")
  print("{i64.MIN} {i64.MAX} {u64.MIN} {u64.MAX}")
  let single: f32 = 0.5
  let double: f64 = 0.5
  let zero: i64 = -0
  let negative: i16 = -7
  print("{single} {double} {zero} {negative}")
}
