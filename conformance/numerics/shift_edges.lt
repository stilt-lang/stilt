test "u8 shifts by 0 and by 7" { //~ PASS
  let one: u8 = 1
  let zero: u8 = 0
  let last: u8 = 7
  assert one << zero == 1
  assert one >> zero == 1
  assert one << last == 128
  assert u8.MAX >> last == 1
}

