//~ rule: program.test-results, numbers.shifts

test "i8 shifts by 0 and by 7" { //~ PASS
  let one: i8 = 1
  let zero: i8 = 0
  let last: i8 = 7
  assert one << zero == 1
  assert one >> zero == 1
  assert one << last == i8.MIN
  assert i8.MAX >> last == 0
}

test "i8 << by 8" { //~ FAIL
  let one: i8 = 1
  let width: i8 = 8
  let _ = one << width
}

test "i8 >> by 8" { //~ FAIL
  let one: i8 = 1
  let width: i8 = 8
  let _ = one >> width
}

test "i8 << by -1" { //~ FAIL
  let one: i8 = 1
  let minus_one: i8 = -1
  let _ = one << minus_one
}

test "i8 >> by -1" { //~ FAIL
  let one: i8 = 1
  let minus_one: i8 = -1
  let _ = one >> minus_one
}

