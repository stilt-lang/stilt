  let g: u8 = 0xff
  let h: u64 = 0xffff_ffff_ffff_ffff
  let i: i8 = -0x80
  let j: i8 = 0b0111_1111
  print("{f} {g} {h} {i} {j}")
  let k: f32 = 3.4028235e38
  let l: f32 = 3.4028235677973366e38
  let m: f32 = 1.000000059604644775390625001
  let n: f32 = 1e-50
