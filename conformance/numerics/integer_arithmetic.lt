//~ rule: numbers.integer-literals, numbers.division-and-remainder, numbers.wrapping, numbers.shifts, numbers.bitwise-operators, numbers.wrapping-conversions, numbers.printing-integers, std.integers
//~ stdout:
//~ | -3 -1 1 3 8 1 7 6 -1 false
//~ | 44 255 144 -9223372036854775808
//~ | 18446744073709551615 6148914691236517205 -1
//~ | [250, 251, 252, 253, 254, 255]

fn main() / io {
  print("{-7 / 2} {-7 % 2} {7 % -2} {7 >> 1} {1 << 3} {5 & 3} {5 | 3} {5 ^ 3} {!0} {!true}")
  let w: u8 = 200
  print("{w +% 100} {w -% 201} {w *% 2} {i64.MAX +% 1}")
  let big: u64 = 18446744073709551615
  print("{big} {big / 3} {big.wrap_to_i8()}")
  var out = List.new()
  for i in 250..=255 {
    let b: u8 = i
    out.push(b)
  }
  print("{out}")
}
