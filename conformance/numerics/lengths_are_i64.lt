//~ rule: numbers.lengths-are-i64, std.str, std.lists

fn count(xs: List<str>) -> i64 {
  let n: i64 = xs.len()
  let first = xs[n - n]
  let bytes: i64 = first.len()
  let pairs: List<(i64, str)> = xs.enumerate(0)
  let at: Option<i64> = first.find("a")
  n + bytes + pairs.len() + (at else 0)
}

fn narrow(xs: List<str>) -> i32 {
  xs.len() //~ ERROR E0311
}

fn unsigned_length(s: str) -> u64 {
  s.len() //~ ERROR E0311
}

fn unsigned_index(xs: List<str>, i: u64) -> str {
  xs[i] //~ ERROR E0311
}

fn small_index(xs: List<str>, i: i32) -> Option<str> {
  xs.get(i) //~ ERROR E0311
}

fn byte_offset(s: str, start: u8) -> str {
  s.slice(start, 2) //~ ERROR E0311
}
