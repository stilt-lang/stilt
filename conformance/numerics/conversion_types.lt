//~ rule: numbers.conversions, numbers.wrapping-conversions

fn widen(b: u8, s: i32, f: f32) -> (i64, u16, i64, f64, f64, u64) {
  (b.to_i64(), b.to_u16(), s.to_i64(), f.to_f64(), s.to_f64(), b.to_u64())
}

fn fallback(n: i64, x: f64) -> (u8, i64) { (n.to_u8() else 0, x.to_i64() else 0) }

fn wrapped(n: i64, m: u64) -> (u8, i64) { (n.wrap_to_u8(), m.wrap_to_i64()) }

fn narrow(n: i64) -> u8 {
  n.to_u8() //~ ERROR E0311
}

fn unsigned_to_signed(n: u64) -> i64 {
  n.to_i64() //~ ERROR E0311
}

fn signed_to_unsigned(n: i8) -> u64 {
  n.to_u64() //~ ERROR E0311
}

fn truncate(x: f64) -> i64 {
  x.to_i64() //~ ERROR E0311
}

fn not_optional(n: u8) -> Option<i64> {
  n.to_i64() //~ ERROR E0311
}

fn narrowed_float(x: f64) -> Option<f32> {
  x.to_f32() //~ ERROR E0311
}

fn float_wrap(x: f64) -> i64 {
  x.wrap_to_i64() //~ ERROR E0314
}

fn bool_to_integer(b: bool) -> i64 {
  b.to_i64() //~ ERROR E0314
}
