//~ rule: numbers.parsing, numbers.printing-floats, std.str
//~ stdout:
//~ | Some(1.0) Some(-2.5) Some(1000.0) Some(1000.0) Some(0.001) Some(7.0) Some(0.3) Some(0.1) Some(-0.0)
//~ | Some(9007199254740992.0) Some(16777216.0) Some(1.0000001) Some(5e-324) Some(0.0) Some(0.0) Some(1.7976931348623157e308) Some(3.4028235e38)
//~ | None None None None None None None
//~ | None None None None None None None None None None None None

fn main() / io {
  print("{"1".to_f64()} {"-2.5".to_f64()} {"1e3".to_f64()} {"1E+3".to_f64()} {"1e-3".to_f64()} {"007.000".to_f64()} {"0.30000000000000000000000000000000001".to_f64()} {"0.1".to_f32()} {"-0".to_f64()}")
  print("{"9007199254740993".to_f64()} {"16777217".to_f32()} {"1.000000059604644775390625001".to_f32()} {"2.4703282292062328e-324".to_f64()} {"2.4703282292062327e-324".to_f64()} {"1e-400".to_f64()} {"1.7976931348623158e308".to_f64()} {"3.4028235677973366e38".to_f32()}")
  print("{"1e309".to_f64()} {"-1e309".to_f64()} {"1.7976931348623159e308".to_f64()} {"3.4028236e38".to_f32()} {"1e39".to_f32()} {"inf".to_f64()} {"nan".to_f32()}")
  print("{"1.".to_f64()} {".5".to_f64()} {"+1.0".to_f64()} {"1e".to_f64()} {"1e+".to_f64()} {" 1.0".to_f64()} {"1.0 ".to_f64()} {"1_0.0".to_f64()} {"1.0f".to_f64()} {"0x1p3".to_f64()} {"".to_f32()} {"-".to_f64()}")
}
