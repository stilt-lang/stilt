//~ rule: numbers.ieee-754, numbers.printing-floats
//~ stdout:
//~ | 16777216.0 16777218.0 0.3 0.30000000000000004 0.33333334 inf
//~ | inf -inf nan -inf -0.0 0.0
//~ | false true false false false true false true
//~ | 9007199254740992.0 9007199254740996.0 0.0 1e-323 nan

fn main() / io {
  let big: f32 = 16777216.0
  let one: f32 = 1.0
  let tenth: f32 = 0.1
  let fifth: f32 = 0.2
  let max: f32 = 3.4028235e38
  print("{big + one + one} {big + (one + one)} {tenth + fifth} {0.1 + 0.2} {one / 3.0} {max * 2.0}")
  let zero = 0.0
  print("{1.0 / zero} {-1.0 / zero} {zero / zero} {1.0 / -zero} {-zero} {zero * -1.0 + zero}")
  let nan = zero / zero
  let inf = 1.0 / zero
  print("{nan == nan} {nan != nan} {nan < 1.0} {nan > 1.0} {nan >= nan} {-0.0 == zero} {-0.0 < zero} {inf > 1e308}")
  let p = 9007199254740992.0
  let tiny = 5e-324
  print("{p + 1.0} {p + 3.0} {tiny / 2.0} {tiny * 1.5} {inf - inf}")
}
