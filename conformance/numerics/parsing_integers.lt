//~ rule: numbers.parsing, std.str
//~ stdout:
//~ | Some(7) Some(-7) Some(0) Some(0) Some(255) Some(-128) Some(127)
//~ | Some(9223372036854775807) Some(-9223372036854775808) Some(18446744073709551615) Some(65535) Some(-2147483648) Some(4294967295) Some(-32768)
//~ | None None None None None None None None
//~ | None None None None None None None None None None None None

fn main() / io {
  print("{"007".to_i64()} {"-007".to_i64()} {"-0".to_i64()} {"0".to_u8()} {"255".to_u8()} {"-128".to_i8()} {"0000127".to_i8()}")
  print("{"9223372036854775807".to_i64()} {"-9223372036854775808".to_i64()} {"18446744073709551615".to_u64()} {"65535".to_u16()} {"-2147483648".to_i32()} {"4294967295".to_u32()} {"-32768".to_i16()}")
  print("{"256".to_u8()} {"-129".to_i8()} {"128".to_i8()} {"9223372036854775808".to_i64()} {"18446744073709551616".to_u64()} {"-1".to_u32()} {"-0".to_u16()} {"99999999999999999999999".to_i64()}")
  print("{"+5".to_i64()} {"1_000".to_i64()} {" 5".to_i64()} {"5\n".to_i64()} {"0x10".to_i64()} {"0b1".to_u8()} {"".to_i64()} {"-".to_i8()} {"1.5".to_i64()} {"1e3".to_i64()} {"--1".to_i64()} {"٣".to_i64()}")
}
