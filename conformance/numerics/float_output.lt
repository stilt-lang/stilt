//~ rule: numbers.float-literals, numbers.negative-literals, numbers.ieee-754, numbers.printing-floats, numbers.float-digits, numbers.float-notation, std.floats
//~ stdout:
//~ | 0.30000000000000004 0.3333333333333333 1e21 1e-7 1e-6 0.0001 1e16 1000000000000000.0
//~ | -0.0 nan -inf inf 5e-324 1.7976931348623157e308
//~ | 0.1 0.3 3.1415927 0.33333334

fn main() / io {
  print("{0.1 + 0.2} {1.0 / 3.0} {1e21} {1e-7} {0.000001} {0.0001} {1e16} {1e15}")
  let zero = 0.0
  print("{-0.0} {zero / zero} {-1.0 / zero} {1.0 / zero} {5e-324} {1.7976931348623157e308}")
  let x: f32 = 0.1
  let third: f32 = 1.0 / 3.0
  print("{x} {x * 3.0} {f32.PI} {third}")
}
