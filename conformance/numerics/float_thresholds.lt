//~ rule: numbers.float-notation
//~ stdout:
//~ | 1234567890123456.0 9999999999999998.0 1.2345678901234568e16 1.5e16 1e17
//~ | 0.000123 0.00099999 1.23e-5 9.9999e-5 0.001
//~ | 100.0 0.5 123.456 -123.456 -1.5e-7 -1e16 0.0001 -0.0001
//~ | 1e22 1e23 1.2e300 -1e-300 1.7976931348623157e308 -5e-324

fn main() / io {
  print("{1234567890123456.0} {9999999999999998.0} {12345678901234567.0} {1.5e16} {1e17}")
  print("{0.000123} {0.00099999} {0.0000123} {0.000099999} {0.001}")
  print("{100.0} {0.5} {123.456} {-123.456} {-1.5e-7} {-1e16} {1e-4} {-0.0001}")
  print("{1e22} {1e23} {1.2e300} {-1e-300} {1.7976931348623157e308} {-5e-324}")
}
