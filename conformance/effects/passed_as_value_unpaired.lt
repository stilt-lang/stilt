//~ rule: effects.passing-to-paired-variables

type Box = { v: i64 }

fn guarded(g: fn() -> i64 / raise<Box>) -> i64 {
  try g() catch b because "a Box gives its value" => b.v
}

fn caller<r>(escaping g: fn() -> i64 / r) -> i64 / r {
  let h: fn(fn() -> i64 / {raise<Box>, r}) -> i64 / r = guarded //~ ERROR E0507
  h(g)
}
