//~ rule: effects.passing-to-paired-variables

type Box = { v: i64 }

fn guarded(g: fn() -> i64 / raise<Box>) -> i64 {
  try g() catch b because "a Box gives its value" => b.v
}

// The signature pairs the implicit row variable of `g` with `str`, but the
// use pairs it with `Box`.
fn caller(g: fn() -> i64) -> i64 / raise<str> {
  guarded(g) //~ ERROR E0507
}
