//~ rule: effects.one-error-type, effects.what-paired-variable-may-raise

// The function's own row pairs the implicit row variable of `g` with `str`.
fn f(g: fn() -> i64) -> i64 / raise<str> {
  let n = g()
  if n > 0 { raise "positive" }
  n
}

fn main() / io {
  let n = try f(|| raise true) catch s because "a str" => s.len() //~ ERROR E0503
  print("{n}")
}
