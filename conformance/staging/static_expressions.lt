//~ tier: meta
//~ rule: meta.static-expressions
//~ stdout:
//~ | 0 1 2 3
//~ | 4
//~ | 5
//~ | 2

use std.array

type Point = { x: i64, y: i64 }

const ORIGIN: Point = Point { x: 2, y: 5 }

const BITS: u8 = 0b1011

fn twice<T: Ord>(x: T, y: T) -> T { if x > y { x } else { y } }

fn spans<n: i64>(a: array.Array<i64, n>) -> str {
  // A `let` of a value parameter is static.
  let last = n
  var line = ""
  comptime for i in 0..=last { line = "{line} {i}" }
  line.trim()
}

fn main() / io {
  let v: array.Array<i64, 3> = [1, 2, 3]
  print(spans(v))
  // A call of a generic function whose row is empty.
  comptime for i in twice(4, 1)..5 { print("{i}") }
  // A field of a static record.
  comptime for i in ORIGIN.y..6 { print("{i}") }
  // A method's call on a constant.
  comptime if BITS.count_ones() == 3 { print("{ORIGIN.x}") }
}
