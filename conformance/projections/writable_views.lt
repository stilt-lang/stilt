//~ tier: advanced
//~ rule: projections.writable-views, projections.places-through-views
//~ stdout:
//~ | [1, 11, 7, 4]
//~ | [0, 0, 7, 4] 1
//~ | [42, 0, 7, 4] [0, 0, 7, 4]

use std.view

fn zero(inout v: view.View<List<i64>>) {
  for i in 0..v.len() {
    v[i] = 0
  }
}

fn bump(inout n: i64) { n += 1 }

type Counter = { n: i64 }

impl Counter {
  fn inc(inout self) { self.n += 1 }
}

fn main() / io {
  var xs = [1, 2, 3, 4]
  {
    var v = view.into(inout xs, 1, 3)
    v[0] = 10
    v[1] += 5
    bump(inout v[0])
    var p = view.part(inout v, 1, 2)
    p[0] = 7
  }
  print("{xs}")
  var cs = [Counter { n: 0 }, Counter { n: 0 }]
  {
    var w = view.into(inout cs, 0, 1)
    w[0].inc()
  }
  {
    var h = view.into(inout xs, 0, 2)
    zero(inout h)
  }
  print("{xs} {cs[0].n}")
  // A writable view of a shared list: the other holder is unchanged.
  let ys = xs
  {
    var v = view.into(inout xs, 0, 1)
    v[0] = 42
  }
  print("{xs} {ys}")
}
