//~ tier: advanced
//~ rule: projections.what-view-writes, projections.writable-bindings, projections.places-through-views
//~ run-output: "[1] 3 [5] [5, 9]"

use std.view

fn main() / io {
  var xs = [1, 2, 3]
  // A `let` binding reads, whatever its view writes, so `xs` can still be read.
  let w = view.into(inout xs, 0, 1)
  let n = xs.len()
  var ys = [4, 5, 6]
  var tail = view.into(inout ys, 1, 3)
  {
    // A writable part of a writable binding writes the binding.
    var p = view.part(inout tail, 1, 2)
    p[0] = 9
  }
  // A view made from `tail` has `tail` as its source.
  let t = tail.view(0, 1)
  print("{w} {n} {t} {tail}")
}
