//~ tier: advanced
//~ rule: projections.writable-views
//~ run-output: "[2, 3]"
//~ panic: bounds
//~ panic-at: part_past_view.lt:17:11

use std.view

// A part of a writable view ends at most at the view's end, though the list it writes goes on.
fn main() / io {
  var xs = [1, 2, 3, 4]
  var v = view.into(inout xs, 1, 3)
  {
    var p = view.part(inout v, 0, 2)
    print("{p}")
  }
  var q = view.part(inout v, 0, 3)
  print("{q}")
}
