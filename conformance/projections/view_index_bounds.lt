//~ tier: advanced
//~ rule: projections.places-through-views
//~ run-output: "20"
//~ panic: bounds
//~ panic-at: view_index_bounds.lt:15:3

use std.view

// An index of a writable view is bounded by the view's length, not by the list it writes.
fn main() / io {
  var xs = [1, 2, 3, 4]
  var v = view.into(inout xs, 1, 3)
  v[1] = 20
  print("{v[1]}")
  v[2] = 30
}
