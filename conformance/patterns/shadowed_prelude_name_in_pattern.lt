//~ rule: program.prelude-names, program.meeting-the-error-type, program.bodies-with-errors, program.check-error-report, patterns.unreachable-arms
//~ run-output: "start"
//~ panic: check-error
//~ panic-at: shadowed_prelude_name_in_pattern.lt:11:4

// `None` is shadowed, so it names nothing: a pattern that names it, against a type without that
// variant, has the error type. The body has an error, so its arms get no warning, and it panics
// when it is called.
type Maybe = | Just(i64) | None //~ ERROR E0209

fn label(n: i64) -> str {
  match n {
    None => "none"
    _ => "other"
  }
}

fn main() / io {
  print("start")
  print(label(1))
}
