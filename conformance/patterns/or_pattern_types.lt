//~ rule: patterns.or-patterns, errors.error-type

type Token = | Num(i64) | Word(str) | Pair(i64, i64)

fn size(t: Token) -> i64 {
  match t {
    Num(n) | Word(n) => n + 1 //~ ERROR E0311
    Pair(a, b) => a + b
  }
}

fn first(t: Token) -> i64 {
  match t {
    Num(n) | Pair(n, _) => n
    Word(w) => w.len()
  }
}

fn missing(t: Token) -> i64 {
  match t {
    Pair(a, b) | Num(a) => a + b //~ ERROR E0217
    Word(_) => 0
  }
}
