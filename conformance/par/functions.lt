//~ rule: par.std-par, par.sequential-meaning, par.fold-tree, par.writes-in-place
//~ stdout:
//~ | [1, 4, 9, 16]
//~ | (3, 5)
//~ | [3.0, 5.0]
//~ | [1, 2]
//~ | e
//~ | a
//~ | (a(bc))
//~ | ((ab)(cd))

use std.par

fn fib(n: i64) -> i64 { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

fn joined(p: str, q: str) -> str { "({p}{q})" }

fn main() / io {
  print("{par.map([1, 2, 3, 4], |x| x * x)}")
  print("{par.both(|| fib(4), || fib(5))}")
  var ys = [1.5, 2.5]
  // Another binding keeps its own copy (values.independent-copies).
  let kept = [1, 2]
  var zs = kept
  par.each(inout ys, |inout y| { y *= 2.0 })
  par.each(inout zs, |inout z| { z += 10 })
  print("{ys}")
  print("{kept}")
  // The tree of the fold shows with a combination that isn't associative.
  print(par.fold([], "e", joined))
  print(par.fold(["a"], "e", joined))
  print(par.fold(["a", "b", "c"], "e", joined))
  print(par.fold(["a", "b", "c", "d"], "e", joined))
}
