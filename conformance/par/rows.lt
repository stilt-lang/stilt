//~ tier: advanced
//~ rule: par.what-runs-in-parallel

use std.par
use std.sync
use std.view

type Bad = | Bad

fn shout(x: i64) -> i64 / io {
  print("{x}")
  x
}

fn printing() -> List<i64> {
  par.map([1], |x| {
    print("{x}") //~ ERROR E0502
    x
  })
}

fn named() -> List<i64> / io {
  par.map([1], shout) //~ ERROR E0311
}

fn reaching(s: sync.Shared<i64>) -> List<i64> {
  par.map([1], |x| when s { s + x }) //~ ERROR E0431
}

fn viewing(xs: List<i64>) -> List<i64> {
  let v = view.View.all(xs)
  par.map([1], |x| v.len() + x) //~ ERROR E0431
}

fn main() {}
