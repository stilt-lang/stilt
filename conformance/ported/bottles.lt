//~ rule: std.lists, std.list-functions, std.str-building
//~ stdout:
//~ | 99 bottles of beer on the wall
//~ | 99 bottles of beer
//~ | Take one down, pass it around
//~ | 98 bottles of beer on the wall
//~ |
//~ | 98 bottles of beer on the wall
//~ | 98 bottles of beer
//~ | Take one down, pass it around
//~ | 97 bottles of beer on the wall
//~ |
//~ | 2 bottles of beer on the wall
//~ | 2 bottles of beer
//~ | Take one down, pass it around
//~ | 1 bottle of beer on the wall
//~ |
//~ | 1 bottle of beer on the wall
//~ | 1 bottle of beer
//~ | Take one down, pass it around
//~ | No more bottles of beer on the wall
//~ | 99 verses

// Rosetta Code, 99 bottles of beer: the song's verses from 99 bottles down to one, with
// "1 bottle" in the singular. Only the first two and the last two verses are printed.

fn bottles(n: i64) -> str {
  if n == 0 { "No more bottles" } else if n == 1 { "1 bottle" } else { "{n} bottles" }
}

fn verse(n: i64) -> str {
  let lines = [
    "{bottles(n)} of beer on the wall", "{bottles(n)} of beer", "Take one down, pass it around",
    "{bottles(n - 1)} of beer on the wall",
  ]
  "\n".join(lines)
}

fn main() / io {
  let song = List.generate(99, |i| verse(99 - i))
  print("\n\n".join(song.take(2).concat(song.take_last(2))))
  print("{song.len()} verses")
}
