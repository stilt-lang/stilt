//~ rule: std.lists, values.independent-copies, std.integers
//~ stdout:
//~ | kitten -> sitting: 3
//~ | rosettacode -> raisethysword: 8
//~ | sitting -> kitten: 3
//~ | "" -> abc: 3
//~ | same -> same: 0

// Rosetta Code, Levenshtein distance: the least number of single-character insertions,
// deletions and substitutions that turn one string into the other. The task gives 3 for
// "kitten" and "sitting", and 8 for "rosettacode" and "raisethysword".

fn distance(a: str, b: str) -> i64 {
  let s = a.chars()
  let t = b.chars()
  var previous = List.generate(t.len() + 1, |j| j)
  for i in 0..s.len() {
    var current = [i + 1]
    for j in 0..t.len() {
      let cost = if s[i] == t[j] { 0 } else { 1 }
      current.push((previous[j] + cost).min(previous[j + 1] + 1).min(current[j] + 1))
    }
    previous = current
  }
  previous[t.len()]
}

fn main() / io {
  for (a, b) in [("kitten", "sitting"), ("rosettacode", "raisethysword"), ("sitting", "kitten")] {
    print("{a} -> {b}: {distance(a, b)}")
  }
  print("\"\" -> abc: {distance("", "abc")}")
  print("same -> same: {distance("same", "same")}")
}
