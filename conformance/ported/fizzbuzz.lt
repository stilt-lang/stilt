// Rosetta Code, FizzBuzz: the numbers from 1 to 100, with multiples of three printed as Fizz,
// multiples of five as Buzz, and multiples of both as FizzBuzz.

fn fizzbuzz(n: i64) -> str {
  match (n % 3, n % 5) {
    (0, 0) => "FizzBuzz"
    (0, _) => "Fizz"
    (_, 0) => "Buzz"
    _ => "{n}"
  }
}

fn main() / io { for n in 1..=100 { print(fizzbuzz(n)) } }
