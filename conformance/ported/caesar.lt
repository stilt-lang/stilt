//~ rule: std.code-points, numbers.no-implicit-conversions, numbers.conversions
//~ stdout:
//~ | The quick brown fox jumps over the lazy dog.
//~ | Esp bftnv mczhy qzi ufxad zgpc esp wlkj ozr.
//~ | The quick brown fox jumps over the lazy dog.
//~ | true

// Rosetta Code, Caesar cipher: each letter is shifted by the key through the alphabet, wrapping
// from Z to A, keeping its case, and every other character stays. With key 11, decoding is
// encoding with key 26 - 11 = 15.

fn shift_byte(b: u8, key: u8) -> u8 {
  if b >= 65 && b <= 90 {
    (b - 65 + key) % 26 + 65
  } else if b >= 97 && b <= 122 {
    (b - 97 + key) % 26 + 97
  } else {
    b
  }
}

fn caesar(text: str, key: i64) -> str {
  let k = key.rem_euclid(26).to_u8() else 0
  str.from_utf8(text.bytes().map(|b| shift_byte(b, k))) else text
}

fn main() / io {
  let plain = "The quick brown fox jumps over the lazy dog."
  let secret = caesar(plain, 11)
  print(plain)
  print(secret)
  print(caesar(secret, -11))
  print("{caesar(secret, 15) == plain}")
}
