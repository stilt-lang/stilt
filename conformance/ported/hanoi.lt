//~ rule: declarations.parameters, values.inout-arguments, expressions.statements
//~ stdout:
//~ | Move disk 1 from A to B
//~ | Move disk 2 from A to C
//~ | Move disk 1 from B to C
//~ | Move disk 3 from A to B
//~ | Move disk 1 from C to A
//~ | Move disk 2 from C to B
//~ | Move disk 1 from A to B
//~ | Move disk 4 from A to C
//~ | Move disk 1 from B to C
//~ | Move disk 2 from B to A
//~ | Move disk 1 from C to A
//~ | Move disk 3 from B to C
//~ | Move disk 1 from A to B
//~ | Move disk 2 from A to C
//~ | Move disk 1 from B to C
//~ | 15 moves

// Rosetta Code, Towers of Hanoi: four disks moved from peg A to peg C through peg B, by moving
// the three above the largest out of the way, the largest across, and the three back on top.
// Four disks take 2^4 - 1 moves.

fn hanoi(disks: i64, from: str, to: str, via: str, inout moves: List<str>) {
  if disks == 0 { return }
  hanoi(disks - 1, from, via, to, inout moves)
  moves.push("Move disk {disks} from {from} to {to}")
  hanoi(disks - 1, via, to, from, inout moves)
}

fn main() / io {
  var moves = []
  hanoi(4, "A", "C", "B", inout moves)
  for m in moves { print(m) }
  print("{moves.len()} moves")
}
