// Rosetta Code, Knapsack problem/0-1: of the task's 22 items, the tourist packs those of the
// greatest total value whose weight is at most 400 decagrams. The task gives the twelve items
// above, weighing 396 and worth 1030. The table holds the best value of the first i items for
// each capacity, and the packed items are read back from it.

type Item = { name: str, weight: i64, value: i64 }

fn item(name: str, weight: i64, value: i64) -> Item { Item { name, weight, value } }

fn items() -> List<Item> {
  [
    item("map", 9, 150),
    item("compass", 13, 35),
    item("water", 153, 200),
    item("sandwich", 50, 160),
    item("glucose", 15, 60),
    item("tin", 68, 45),
    item("banana", 27, 60),
    item("apple", 39, 40),
    item("cheese", 23, 30),
    item("beer", 52, 10),
    item("suntan cream", 11, 70),
    item("camera", 32, 30),
    item("T-shirt", 24, 15),
    item("trousers", 48, 10),
    item("umbrella", 73, 40),
    item("waterproof trousers", 42, 70),
    item("waterproof overclothes", 43, 75),
    item("note-case", 22, 80),
    item("sunglasses", 7, 20),
    item("towel", 18, 12),
    item("socks", 4, 50),
    item("book", 30, 10),
  ]
}

fn pack(all: List<Item>, capacity: i64) -> List<Item> {
  var best = [List.repeat(0, capacity + 1)]
  for it in all {
    let last = best[best.len() - 1]
    best.push(
      List.generate(capacity + 1, |w| {
        if it.weight > w { last[w] } else { last[w].max(last[w - it.weight] + it.value) }
      }),
    )
  }
  var packed = []
  var w = capacity
  for k in 1..=all.len() {
    let i = all.len() - k
    if best[i + 1][w] != best[i][w] {
      packed.push(all[i])
      w -= all[i].weight
    }
  }
  packed.reversed()
}

fn main() / io {
  let packed = pack(items(), 400)
  for it in packed { print(it.name) }
  print("weight {i64.sum(packed.map(.weight))}, value {i64.sum(packed.map(.value))}")
}
