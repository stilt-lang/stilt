//~ tier: meta
//~ rule: meta.std-meta, meta.shape-and-name, meta.shapes, meta.shape-accessors
//~ stdout:
//~ | float 0.10000000149011612 0.10000000149011612 inf
//~ | float 0.1 0.1 1e40
//~ | bool true false
//~ | str "hi" "made"
//~ | unit true

use std.meta

// `get` gives an `f32` exactly as an `f64`, and `make` rounds back to `f32`
// as numbers.conversions does.
fn floats<T>(value: T) -> str {
  match T.shape() {
    Float(x) => "float {x.get(value)} {x.get(x.make(0.1))} {x.get(x.make(1e40))}"
    _ => "no float"
  }
}

fn others<T>(value: T) -> str {
  match T.shape() {
    Bool(b) => "bool {b.get(value)} {b.get(b.make(false))}"
    Str(s) => "str \"{s.get(value)}\" \"{s.get(s.make("made"))}\""
    Unit(u) => "unit {u.get(value) == u.get(u.make(()))}"
    _ => "other"
  }
}

fn main() / io {
  print(floats(0.1.to_f32()))
  print(floats(0.1))
  print(others(true))
  print(others("hi"))
  print(others(()))
}
