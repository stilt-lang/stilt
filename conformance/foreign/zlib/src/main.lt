// zlib's `crc32` over a list that `with_ptr` lends: the CRC-32 of "hello" is 0x3610A686, and of
// no byte, 0. The package's manifest links zlib, which the program loads when it starts.

use std.c

extern fn crc32(crc: u64, buf: c.Ptr<u8>, len: u32) -> u64

pub fn checksum(data: List<u8>) -> u64 {
  let len = data.len().wrap_to_u32()
  unsafe because "crc32 reads len bytes from buf, which with_ptr keeps alive for the call" {
    data.with_ptr(|p| crc32(0, p, len))
  }
}

fn main() / io {
  print("{checksum([104, 101, 108, 108, 111])}")
  print("{checksum([])}")
}
