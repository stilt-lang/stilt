//~ tier: advanced
//~ rule: views.escaping
//~ run-output: "ab 2"

use std.view

// A view whose sources are `let` parameters may be returned, through a binding too.
fn whole(s: str) -> view.View<str> {
  let v = view.View.all(s)
  v
}

// A closure that captures a view and is only called in the function doesn't escape.
fn count(s: str) -> i64 {
  let v = view.View.all(s)
  let f = || v.len()
  f()
}

fn main() / io { print("{whole("ab")} {count("ab")}") }
