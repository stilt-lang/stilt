//~ rule: std.date-times
//~ stdout:
//~ | 1970 1 1 0 0 0 0 4
//~ | 2025-11-15 9:30:0 250000000 6 1763199000 1763199000250
//~ | 1969 12 31 59 999000000 -1 -1
//~ | true None true None None None None
//~ | 2024-03-01T00:00:00Z 2024-02-29T23:59:57.5Z 86400s
//~ | true 0001-01-01T00:00:00Z true

use std.clock

fn main() / io {
  let epoch = clock.DateTime.from_unix_seconds(0)
  print("{epoch.year} {epoch.month} {epoch.day} {epoch.hour} {epoch.minute} {epoch.second} {epoch.nanosecond} {epoch.weekday()}")
  let t = clock.DateTime.from_unix_ms(1763199000250)
  print("{t.year}-{t.month}-{t.day} {t.hour}:{t.minute}:{t.second} {t.nanosecond} {t.weekday()} {t.unix_seconds()} {t.unix_ms()}")
  let before = clock.DateTime.from_unix_ms(-1)
  print("{before.year} {before.month} {before.day} {before.second} {before.nanosecond} {before.unix_seconds()} {before.unix_ms()}")
  let of = clock.DateTime.of
  print("{of(2024, 2, 29, 12, 0, 0).is_some()} {of(2023, 2, 29, 12, 0, 0)} {of(2000, 2, 29, 0, 0, 0).is_some()} {of(1900, 2, 29, 0, 0, 0)} {of(2024, 13, 1, 0, 0, 0)} {of(2024, 4, 31, 0, 0, 0)} {of(2024, 1, 1, 0, 60, 0)}")
  let leap = of(2024, 2, 29, 23, 59, 59) else return
  let day_before = of(2024, 2, 28, 23, 59, 59) else return
  print("{leap.plus(clock.Duration.from_seconds(1))} {leap.plus(clock.Duration.from_ms(-1500))} {leap.since(day_before)}")
  print("{epoch < t} {clock.DateTime.from_unix_seconds(-62135596800)} {clock.DateTime.now().year >= 2025}")
}
