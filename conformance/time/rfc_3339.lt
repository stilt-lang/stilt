//~ rule: std.rfc-3339
//~ stdout:
//~ | 2025-11-15T09:30:00Z 2025-11-15T09:30:00.25Z 1970-01-01T00:00:00.000001Z
//~ | 12345-01-02T03:04:05Z 0007-01-02T03:04:05Z -1-01-02T03:04:05Z [2025-11-15T09:30:00Z]
//~ | true true
//~ | Some(2025-11-15T09:30:00.25Z) Some(2025-11-15T09:30:00Z) Some(2025-11-15T09:30:00.123456789Z)
//~ | Some(2025-01-01T00:00:59Z)
//~ | [None, None, None, None, None, None, None, None, None, None, None, None]

use std.clock

fn main() / io {
  let t = clock.DateTime.from_unix_seconds(1763199000)
  print("{t.to_rfc3339()} {t.plus(clock.Duration.from_ms(250))} {clock.DateTime.from_unix_seconds(0).plus(clock.Duration.from_us(1))}")
  let far = clock.DateTime { year: 12345, month: 1, day: 2, hour: 3, minute: 4, second: 5, nanosecond: 0 }
  let early = clock.DateTime { ..far, year: 7 }
  let negative = clock.DateTime { ..far, year: -1 }
  print("{far} {early} {negative} {[t]}")
  let read = clock.DateTime.from_rfc3339
  print("{read("2025-11-15T09:30:00Z") == Some(t)} {read("2025-11-15t09:30:00z") == Some(t)}")
  print("{read("2025-11-15T10:30:00.25+01:00")} {read("2025-11-15T00:00:00-09:30")} {read("2025-11-15T09:30:00.1234567891Z")}")
  print("{read("2024-12-31T23:59:59-00:01")}")
  let rejected = ["2025-11-15 09:30:00Z", "2025-11-15T09:30:00", "2025-11-15T09:30:00.Z", "2025-11-15T09:30:60Z", "2025-02-29T00:00:00Z", "2025-11-15T09:30:00+24:00", "2025-11-15T09:30:00+01:60", "2025-11-15T09:30:00Zx", "25-11-15T09:30:00Z", "2025-11-15T9:30:00Z", "+2025-11-15T09:30:00Z", "2025-11-15T09:30:00+0100"]
  print("{rejected.map(|s| read(s))}")
}
