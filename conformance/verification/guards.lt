//~ rule: facts.verification, facts.what-proofs-change, facts.rules-of-acceptance, facts.known-signs, facts.guarding-tests, facts.guards
//~ run-output: "5 0 5 0 5 0 5 0 6 6 0 [0, 2] [true, true, true, true, false, true, false, true, false, false, false]"

// Tests that give `i >= 0` and `i < xs.len()` guard each index, with nothing
// between them and the index that writes `i` or changes the list's length.

fn at(xs: List<i64>, i: i64) -> i64 without panic {
  if i >= 0 && i < xs.len() { xs[i] } else { 0 }
}

// Each of two nested tests gives one, the second in its mirrored form.
fn nested(xs: List<i64>, i: i64) -> i64 without panic {
  if 0 <= i {
    if xs.len() > i { xs[i] } else { 0 }
  } else {
    0
  }
}

// The negation of an `||` chain gives the negation of each disjunct, to the
// `else` branch, and to the code after the `if` when its branch returns.
fn otherwise(xs: List<i64>, i: i64) -> i64 without panic {
  if i < 0 || i >= xs.len() { 0 } else { xs[i] }
}

fn early(xs: List<i64>, i: i64) -> i64 without panic {
  if i < 0 || i >= xs.len() { return 0 }
  xs[i]
}

// `i` is known non-negative, and the loop's condition guards its body, before
// the step and after it.
fn total(xs: List<i64>) -> i64 without panic {
  var s = 0
  var i = 0
  while i < xs.len() {
    s += xs[i]
    i += 1
  }
  s
}

fn first(xs: List<i64>) -> i64 without panic {
  if !xs.is_empty() { xs[0] } else { 0 }
}

// A write through an element changes no length.
fn cleared(xs: List<i64>, i: i64) -> List<i64> without panic {
  var ys = xs
  if i >= 0 && i < ys.len() { ys[i] = 0 }
  ys
}

// `k` starts at `i + i`, known non-negative since `i` starts at 2, and grows
// only by `i`.
fn clear_multiples(m: i64) -> List<bool> without panic, div {
  var flags = []
  for _ in 0..m + 1 { flags.push(true) }
  for i in 2..flags.len() {
    var k = i + i
    while k < flags.len() {
      flags[k] = false
      k += i
    }
  }
  flags
}

fn main() / io {
  let xs = [5, 6]
  print("{at(xs, 0)} {at(xs, 2)} {nested(xs, 0)} {nested(xs, -1)} {otherwise(xs, 0)} {otherwise(xs, 5)} {early(xs, 0)} {early(xs, -3)} {at(xs, 1)} {total([1, 2, 3])} {first([])} {cleared([1, 2], 0)} {clear_multiples(10)}")
}
