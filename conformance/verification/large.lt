//~ rule: facts.rules-of-acceptance, facts.range-loops, facts.large-bodies
//~ run-output: "67"

// The body counts `xs`, the 59 `let`s, `s`, three for the `for` over a
// range, its `i` among them, and zero: 65 terms, so the analysis keeps only
// each term's bounds. A body's size changes nothing that `check` accepts: the
// range loop proves the index.
fn sum(xs: List<i64>) -> i64 without panic {
  let a1 = xs.len()
  let a2 = a1 + 1
  let a3 = a2 + 1
  let a4 = a3 + 1
  let a5 = a4 + 1
  let a6 = a5 + 1
  let a7 = a6 + 1
  let a8 = a7 + 1
  let a9 = a8 + 1
  let a10 = a9 + 1
  let a11 = a10 + 1
  let a12 = a11 + 1
  let a13 = a12 + 1
  let a14 = a13 + 1
  let a15 = a14 + 1
  let a16 = a15 + 1
  let a17 = a16 + 1
  let a18 = a17 + 1
  let a19 = a18 + 1
  let a20 = a19 + 1
  let a21 = a20 + 1
  let a22 = a21 + 1
  let a23 = a22 + 1
  let a24 = a23 + 1
  let a25 = a24 + 1
  let a26 = a25 + 1
  let a27 = a26 + 1
  let a28 = a27 + 1
  let a29 = a28 + 1
  let a30 = a29 + 1
  let a31 = a30 + 1
  let a32 = a31 + 1
  let a33 = a32 + 1
  let a34 = a33 + 1
  let a35 = a34 + 1
  let a36 = a35 + 1
  let a37 = a36 + 1
  let a38 = a37 + 1
  let a39 = a38 + 1
  let a40 = a39 + 1
  let a41 = a40 + 1
  let a42 = a41 + 1
  let a43 = a42 + 1
  let a44 = a43 + 1
  let a45 = a44 + 1
  let a46 = a45 + 1
  let a47 = a46 + 1
  let a48 = a47 + 1
  let a49 = a48 + 1
  let a50 = a49 + 1
  let a51 = a50 + 1
  let a52 = a51 + 1
  let a53 = a52 + 1
  let a54 = a53 + 1
  let a55 = a54 + 1
  let a56 = a55 + 1
  let a57 = a56 + 1
  let a58 = a57 + 1
  let a59 = a58 + 1
  var s = 0
  for i in 0..xs.len() { s += xs[i] }
  s + a59
}

fn main() / io { print("{sum([1, 2, 3])}") }
