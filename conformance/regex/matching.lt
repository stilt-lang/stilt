//~ rule: std.regex, std.regex-syntax, std.regex-matching
//~ stdout:
//~ | 2-5 [abc]
//~ | 4-7 [abc]
//~ | 3-6 [123]
//~ | 1-5 [1.25]
//~ | 0-6 [colour]
//~ | 0-3 [aaa]
//~ | 0-2 [aa]
//~ | none
//~ | 0-5 [aaaaa]
//~ | 0-0 []
//~ | 0-1 [a]
//~ | 0-2 [ab]
//~ | none
//~ | 1-2 [b]
//~ | 7-10 [cat]
//~ | 3-6 [cat]
//~ | 4-7 [DEF]
//~ | 3-7 [éé]
//~ | 2-4 [ï]
//~ | 2-5 [_x9]
//~ | 1 4
//~ | 0-6 [ababab]
//~ | 0-3 []a]]
//~ | 0-4 [a-a-]
//~ | 1-3 [.*]
//~ | none
//~ | 0-4 [aaab]
//~ | true false true

use std.regex

fn find(source: str, text: str) -> str {
  let re = try regex.compile(source) catch e => return "error {e}"
  match re.find(text) {
    Some(m) => "{m.start}-{m.end} [{m.text}]",
    None => "none",
  }
}

fn main() / io {
  print(find("abc", "xxabcxx"))
  // `.` takes any scalar value but a line feed.
  print(find("a.c", "a\nc abc"))
  print(find("[0-9]+", "ab 123 45"))
  print(find("\\d+\\.\\d*", "v1.25"))
  print(find("colou?r", "colour"))
  // Counts, greedy and lazy, and a count the text can't meet.
  print(find("a\{2,3}", "aaaa"))
  print(find("a\{2,3}?", "aaaa"))
  print(find("a\{2}", "a"))
  print(find("a\{2,}", "aaaaa"))
  // A match may be empty, and starts as far left as it can.
  print(find("x*", "abc"))
  // Alternatives are tried in order: the first that leads to a match wins.
  print(find("a|ab", "ab"))
  print(find("ab|a", "ab"))
  print(find("^b", "ab"))
  print(find("b$", "ab"))
  print(find("\\bcat\\b", "concat cat"))
  print(find("\\Bcat", "concat cat"))
  print(find("[^a-z ]+", "abc DEF ghi"))
  // Offsets count bytes, and classes take scalar values.
  print(find("é+", "caféé!"))
  print(find("[à-ÿ]", "naïve"))
  print(find("\\w+", "  _x9-"))
  let spaces = try regex.compile("\\s+") catch e => { print("error {e}"); return }
  let m = spaces.find("a \t\nb") else return
  print("{m.start} {m.end}")
  print(find("(?:ab)+", "ababab"))
  // A `]` first in a class, and a `-` last, stand for themselves.
  print(find("[]a]+", "]a]b"))
  print(find("[a-]+", "a-a-b"))
  print(find("\\.\\*", "a.*b"))
  // Nested repetitions: the machine keeps one thread per instruction.
  print(find("(a*)*b", "{"a".repeat(2000)}c"))
  print(find("(a|aa)*b", "aaab"))
  let word = try regex.compile("^\\w+$") catch e => { print("error {e}"); return }
  print("{word.is_match("abc")} {word.is_match("a c")} {word.is_match("_")}")
}
