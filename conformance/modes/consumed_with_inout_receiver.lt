//~ rule: values.passing-values, modes.durations, modes.overlapping-inout
//~ run-output: "Bag { items: [1, 2, 1, 2, 0] }"

type Bag = { items: List<i64> }

impl Bag {
  fn absorb(inout self, other: Bag) {
    var rest = other
    rest.items.push(0)
    for x in rest.items { self.items.push(x) }
  }
}

fn main() / io {
  var b = Bag { items: [1, 2] }
  b.absorb(b)
  print("{b}")
}
