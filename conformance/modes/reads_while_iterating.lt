//~ rule: modes.kinds-of-access, modes.durations, modes.closures
//~ stdout:
//~ | 1 3 1 [1, 2, 3] 6 3
//~ | 2 3 1 [1, 2, 3] 6 3
//~ | 3 3 1 [1, 2, 3] 6 3
//~ | [1, 2, 3, 4]

fn total(xs: List<i64>) -> i64 { xs.fold(0, |a, x| a + x) }

fn main() / io {
  var xs = [1, 2, 3]
  for x in xs {
    let n = xs.len()
    let first = xs[0]
    let copy = xs
    let sum = total(xs)
    let count = || xs.len()
    print("{x} {n} {first} {copy} {sum} {count()}")
  }
  xs.push(4)
  print("{xs}")
}
