//~ rule: values.assignment-order, values.compound-assignment-order, modes.durations
//~ run-output: "[3, 2, 1, 3] P { a: 3, b: 2 }"

type P = { a: i64, b: i64 }

fn main() / io {
  var xs = [1, 2, 3]
  xs[xs.len() - 1] = xs[0]
  xs[0] += xs[1]
  xs.push(xs.len())
  var p = P { a: 1, b: 2 }
  p.a = p.b + p.a
  print("{xs} {p}")
}
