//~ rule: modes.overlap, modes.law, modes.overlapping-inout

type Pair = { a: i64, b: i64 }

impl Pair {
  fn bump(inout self, inout n: i64) { self.a += n }
}

fn swap(inout x: i64, inout y: i64) {
  let t = x
  x = y
  y = t
}

fn put(inout p: Pair, inout n: i64) { p.b = n }

fn calls() {
  var p = Pair { a: 1, b: 2 }
  var n = 0
  swap(inout n, inout n) //~ ERROR E0402
  put(inout p, inout p.a) //~ ERROR E0402
  p.bump(inout p.b) //~ ERROR E0402
  swap(inout p.a, inout p.b)
}
