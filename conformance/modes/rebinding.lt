//~ rule: patterns.var-bindings, modes.what-can-be-modified
//~ run-output: "[1, 2] [3, 4] 6 [5, 6] Counter { n: 1 }"

type Counter = { n: i64 }

impl Counter {
  fn bumped(self) -> Counter {
    var c = self
    c.n += 1
    c
  }
}

fn grow(xs: List<i64>) -> List<i64> {
  var xs = xs
  xs.push(2)
  xs
}

fn appended(xs: List<i64>) -> List<i64> {
  var xs = xs
  xs.push(4)
  xs
}

fn main() / io {
  let a = grow([1])
  let b = appended([3])
  var total = 0
  for x in [1, 2] {
    var x = x
    x *= 2
    total += x
  }
  let c = match Some([5]) {
    Some(ys) => {
      var ys = ys
      ys.push(6)
      ys
    }
    None => []
  }
  let d = Counter { n: 0 }.bumped()
  print("{a} {b} {total} {c} {d}")
}
