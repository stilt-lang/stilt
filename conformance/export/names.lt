//~ rule: c.exported-names

// An exported function's name is its C symbol, so it can't be one that the C or C++ program
// it is linked into can already mean.

pub extern fn int() -> i64 { //~ ERROR E0352
  0
}

pub extern fn class() -> i64 { //~ ERROR E0352
  0
}

