// The histograms of the report, each of a number of buckets given where it is made.

use std.json
use decode
use histogram
use events.entry

/// The histograms: the time requests took and the size of their answers, the time slow
/// queries took, the entries in each five minutes of the hour, and the requests' statuses.
pub type Charts = {
  latency: histogram.Histogram,
  sizes: histogram.Histogram,
  queries: histogram.Histogram,
  minutes: histogram.Histogram,
  statuses: histogram.Histogram,
}

/// Empty histograms.
pub fn new() -> Charts {
  Charts {
    latency: histogram.new(8, 0, 50),
    sizes: histogram.new(6, 0, 4096),
    queries: histogram.new(5, 200, 200),
    minutes: histogram.new(12, 0, 5),
    statuses: histogram.new(5, 100, 100),
  }
}

impl Charts {
  /// Counts the entry in the histograms it belongs to.
  pub fn add(inout self, e: entry.Entry) {
    self.minutes.add(e.at.minute.to_i64())
    match e.event {
      Http(r) => {
        self.latency.add(r.millis)
        self.sizes.add(r.bytes)
        self.statuses.add(r.status)
      }
      Sql(q) => self.queries.add(q.millis)
      _ => {}
    }
  }

  /// The histograms, each under its title, with the bucket that holds its middle value.
  pub fn lines(self) -> List<str> {
    var out: List<str> = []
    out.extend(titled("request time, in ms", self.latency.median(), self.latency.lines()))
    out.extend(titled("response size, in bytes", self.sizes.median(), self.sizes.lines()))
    out.extend(titled("slow queries, in ms", self.queries.median(), self.queries.lines()))
    out.extend(
      titled("entries per five minutes of the hour", self.minutes.median(), self.minutes.lines()),
    )
    out.extend(titled("statuses", self.statuses.median(), self.statuses.lines()))
    out
  }

  /// The histograms that the JSON at `path` holds.
  pub fn read(v: json.Value, path: str) -> Charts / raise<json.Error> {
    let ms = try decode.members(v, path, "Charts")
    Charts {
      latency: try histogram.Histogram.read(
        try decode.field(ms, "latency", path),
        "{path}.latency",
      ),
      sizes: try histogram.Histogram.read(try decode.field(ms, "sizes", path), "{path}.sizes"),
      queries: try histogram.Histogram.read(
        try decode.field(ms, "queries", path),
        "{path}.queries",
      ),
      minutes: try histogram.Histogram.read(
        try decode.field(ms, "minutes", path),
        "{path}.minutes",
      ),
      statuses: try histogram.Histogram.read(
        try decode.field(ms, "statuses", path),
        "{path}.statuses",
      ),
    }
  }
}

impl json.ToJson for Charts {
  fn to_json(self) -> json.Value {
    json.Object(
      [
        ("latency", self.latency.to_json()),
        ("sizes", self.sizes.to_json()),
        ("queries", self.queries.to_json()),
        ("minutes", self.minutes.to_json()),
        ("statuses", self.statuses.to_json()),
      ],
    )
  }
}

impl json.FromJson for Charts {
  fn from_json(v: json.Value) -> Charts / raise<json.Error> { try Charts.read(v, "$") }
}

// A histogram's lines under its title.
fn titled(title: str, median: str, rows: List<str>) -> List<str> {
  ["== {title} ==", "median in {median}"].concat(rows)
}
