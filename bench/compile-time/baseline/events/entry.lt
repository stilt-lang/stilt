// An entry of the log: when, where and how severe, and the event it records.

use std.json
use decode
use events.access
use events.ops
use events.time
use events.web

/// The event an entry records, one for each topic of the log.
pub type Event =
  | Http(web.Request)
  | Sql(web.Query)
  | Auth(access.Login)
  | Cache(access.Cache)
  | Job(ops.Job)
  | Disk(ops.Disk)
  | Deploy(ops.Deploy)
  | Config(ops.Setting)
  | Panic(ops.Crash)
  | Retry(ops.Retry)

/// An entry: when it was written, by which host, how severe it is, and its event.
pub type Entry = { at: time.Stamp, source: time.Source, level: time.Level, event: Event }

/// The topics, in the order the report lists them.
pub const TOPICS: List<str> = [
  "http", "sql", "auth", "cache", "job", "disk", "deploy", "config", "panic", "retry",
]

impl Event {
  /// The topic of the event, as a line writes it.
  /// ex: Disk(ops.Disk { mount: "/", percent: 1 }).topic() == "disk"
  pub fn topic(self) -> str {
    match self {
      Http(_) => "http"
      Sql(_) => "sql"
      Auth(_) => "auth"
      Cache(_) => "cache"
      Job(_) => "job"
      Disk(_) => "disk"
      Deploy(_) => "deploy"
      Config(_) => "config"
      Panic(_) => "panic"
      Retry(_) => "retry"
    }
  }

  /// The kind of the event: its topic, and what happened for the topics whose events differ in
  /// that.
  /// ex: Cache(access.Miss(access.Key { space: "s", id: 1 })).kind() == "cache miss"
  /// ex: Disk(ops.Disk { mount: "/", percent: 1 }).kind() == "disk"
  pub fn kind(self) -> str {
    match self {
      Http(r) => "http {r.method.label()}"
      Auth(l) => if l.ok { "auth ok" } else { "auth failed" }
      Cache(c) => "cache {c.action()}"
      Job(j) => "job {j.state()}"
      _ => self.topic()
    }
  }

  /// What the event says, in a few words.
  /// ex: Disk(ops.Disk { mount: "/var", percent: 91 }).summary() == "/var at 91%"
  pub fn summary(self) -> str {
    match self {
      Http(r) => r.text()
      Sql(q) => "{q.table} took {q.millis}ms for {q.rows} rows"
      Auth(l) => "{l.user} from {l.ip.text()} {if l.ok { "logged in" } else { "failed" }}"
      Cache(c) => "{c.action()} {c.key().text()}"
      Job(j) => "{j.name()} {j.state()}"
      Disk(d) => "{d.mount} at {d.percent}%"
      Deploy(d) => d.text()
      Config(s) => "{s.key}: {s.before} -> {s.after}"
      Panic(c) => "{c.thread}: {c.message}"
      Retry(r) => "{r.op} attempt {r.attempt} of {r.limit}"
    }
  }
}

impl Entry {
  /// The entry as one line of the report: its time, host, level and what its event says.
  pub fn line(self) -> str {
    "{self.at.text()} {self.source.text()} {self.level.label()} {self.event.topic()}: {self.event.summary()}"
  }
}

// JSON, written and read by hand as `std.json` would from the types' shapes (std.json).

impl Event {
  /// The event's variant, as its name.
  /// ex: Disk(ops.Disk { mount: "/", percent: 1 }).name() == "Disk"
  pub fn name(self) -> str {
    match self {
      Http(_) => "Http"
      Sql(_) => "Sql"
      Auth(_) => "Auth"
      Cache(_) => "Cache"
      Job(_) => "Job"
      Disk(_) => "Disk"
      Deploy(_) => "Deploy"
      Config(_) => "Config"
      Panic(_) => "Panic"
      Retry(_) => "Retry"
    }
  }

  /// The event that the JSON at `path` holds.
  pub fn read(v: json.Value, path: str) -> Event / raise<json.Error> {
    let (name, p) = decode.named(v) else raise decode.mismatch("Event", v, path)
    let at = "{path}.{name}"
    let expected = match name {
      "Http" => "(Request,)"
      "Sql" => "(Query,)"
      "Auth" => "(Login,)"
      "Cache" => "(Cache,)"
      "Job" => "(Job,)"
      "Disk" => "(Disk,)"
      "Deploy" => "(Deploy,)"
      "Config" => "(Setting,)"
      "Panic" => "(Crash,)"
      "Retry" => "(Retry,)"
      _ => raise decode.mismatch("Event", v, path)
    }
    let x = (try decode.payload(p, at, 1, expected))[0]
    let one = "{at}[0]"
    match name {
      "Http" => Http(try web.Request.read(x, one))
      "Sql" => Sql(try web.Query.read(x, one))
      "Auth" => Auth(try access.Login.read(x, one))
      "Cache" => Cache(try access.Cache.read(x, one))
      "Job" => Job(try ops.Job.read(x, one))
      "Disk" => Disk(try ops.Disk.read(x, one))
      "Deploy" => Deploy(try ops.Deploy.read(x, one))
      "Config" => Config(try ops.Setting.read(x, one))
      "Panic" => Panic(try ops.Crash.read(x, one))
      _ => Retry(try ops.Retry.read(x, one))
    }
  }
}

impl json.ToJson for Event {
  fn to_json(self) -> json.Value {
    let payload = match self {
      Http(r) => r.to_json()
      Sql(q) => q.to_json()
      Auth(l) => l.to_json()
      Cache(c) => c.to_json()
      Job(j) => j.to_json()
      Disk(d) => d.to_json()
      Deploy(d) => d.to_json()
      Config(s) => s.to_json()
      Panic(c) => c.to_json()
      Retry(r) => r.to_json()
    }
    decode.variant(self.name(), [payload])
  }
}

impl json.FromJson for Event {
  fn from_json(v: json.Value) -> Event / raise<json.Error> { try Event.read(v, "$") }
}

impl Entry {
  /// The entry that the JSON at `path` holds.
  pub fn read(v: json.Value, path: str) -> Entry / raise<json.Error> {
    let ms = try decode.members(v, path, "Entry")
    Entry {
      at: try time.Stamp.read(try decode.field(ms, "at", path), "{path}.at"),
      source: try time.Source.read(try decode.field(ms, "source", path), "{path}.source"),
      level: try time.Level.read(try decode.field(ms, "level", path), "{path}.level"),
      event: try Event.read(try decode.field(ms, "event", path), "{path}.event"),
    }
  }
}

impl json.ToJson for Entry {
  fn to_json(self) -> json.Value {
    json.Object(
      [
        ("at", self.at.to_json()),
        ("source", self.source.to_json()),
        ("level", self.level.to_json()),
        ("event", self.event.to_json()),
      ],
    )
  }
}

impl json.FromJson for Entry {
  fn from_json(v: json.Value) -> Entry / raise<json.Error> { try Entry.read(v, "$") }
}
