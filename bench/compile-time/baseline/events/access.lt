// Who logged in, from where, and what the cache did with their sessions.

use std.json
use decode

/// An address of IPv4: its four numbers.
pub type Ip = { a: u8, b: u8, c: u8, d: u8 }

/// A login: the user, the address it came from, whether it succeeded, and how many attempts it
/// took when the line says.
pub type Login = { user: str, ip: Ip, ok: bool, attempts: Option<i64> }

/// A key of the cache: its space and its number, as in `user:42`.
pub type Key = { space: str, id: i64 }

/// What the cache did: found a key, missed it, or evicted it, freeing some bytes.
pub type Cache = | Hit(Key) | Miss(Key) | Evict(Key, i64)

impl Ip {
  /// The address of four numbers, each below 256.
  /// ex: Ip.parse(["10", "0", "0", "4"]) == Some(Ip { a: 10, b: 0, c: 0, d: 4 })
  /// ex: Ip.parse(["10", "0", "0", "256"]) == None
  pub fn parse(parts: List<str>) -> Option<Ip> {
    let numbers = Option.all(parts.map(|p| p.to_u8())) else return None
    let [a, b, c, d] = numbers else return None
    Some(Ip { a, b, c, d })
  }

  /// The address as a line writes it.
  /// ex: Ip { a: 10, b: 0, c: 0, d: 4 }.text() == "10.0.0.4"
  pub fn text(self) -> str { "{self.a}.{self.b}.{self.c}.{self.d}" }

  /// Whether the address belongs to a private network.
  /// ex: Ip { a: 10, b: 1, c: 2, d: 3 }.private()
  /// ex: Ip { a: 192, b: 168, c: 0, d: 1 }.private()
  /// ex: !Ip { a: 8, b: 8, c: 8, d: 8 }.private()
  pub fn private(self) -> bool {
    self.a == 10 ||
      (self.a == 172 && self.b >= 16 && self.b < 32) ||
      (self.a == 192 && self.b == 168)
  }
}

impl Login {
  /// The attempts the login took: those the line gave, or one.
  /// ex: Login { user: "a", ip: Ip { a: 1, b: 1, c: 1, d: 1 }, ok: true, attempts: None }.tries() == 1
  pub fn tries(self) -> i64 { self.attempts else 1 }
}

impl Key {
  /// The key as a line writes it.
  /// ex: Key { space: "user", id: 42 }.text() == "user:42"
  pub fn text(self) -> str { "{self.space}:{self.id}" }
}

impl Cache {
  /// The key the cache looked up or evicted.
  /// ex: Evict(Key { space: "s", id: 1 }, 10).key() == Key { space: "s", id: 1 }
  pub fn key(self) -> Key {
    match self {
      Hit(k) | Miss(k) | Evict(k, _) => k
    }
  }

  /// What the cache did, in a word.
  /// ex: Miss(Key { space: "s", id: 1 }).action() == "miss"
  pub fn action(self) -> str {
    match self {
      Hit(_) => "hit"
      Miss(_) => "miss"
      Evict(_, _) => "evict"
    }
  }
}

// JSON, written and read by hand as `std.json` would from the types' shapes (std.json).

impl Ip {
  /// The address that the JSON at `path` holds.
  pub fn read(v: json.Value, path: str) -> Ip / raise<json.Error> {
    let ms = try decode.members(v, path, "Ip")
    Ip {
      a: try decode.small(try decode.field(ms, "a", path), "{path}.a"),
      b: try decode.small(try decode.field(ms, "b", path), "{path}.b"),
      c: try decode.small(try decode.field(ms, "c", path), "{path}.c"),
      d: try decode.small(try decode.field(ms, "d", path), "{path}.d"),
    }
  }
}

impl json.ToJson for Ip {
  fn to_json(self) -> json.Value {
    json.Object(
      [
        ("a", json.Number("{self.a}")),
        ("b", json.Number("{self.b}")),
        ("c", json.Number("{self.c}")),
        ("d", json.Number("{self.d}")),
      ],
    )
  }
}

impl json.FromJson for Ip {
  fn from_json(v: json.Value) -> Ip / raise<json.Error> { try Ip.read(v, "$") }
}

impl Login {
  /// The login that the JSON at `path` holds.
  pub fn read(v: json.Value, path: str) -> Login / raise<json.Error> {
    let ms = try decode.members(v, path, "Login")
    Login {
      user: try decode.text(try decode.field(ms, "user", path), "{path}.user"),
      ip: try Ip.read(try decode.field(ms, "ip", path), "{path}.ip"),
      ok: try decode.flag(try decode.field(ms, "ok", path), "{path}.ok"),
      attempts: try decode.maybe_int(ms, "attempts", path),
    }
  }
}

impl json.ToJson for Login {
  fn to_json(self) -> json.Value {
    json.Object(
      [
        ("user", json.Text(self.user)),
        ("ip", self.ip.to_json()),
        ("ok", json.Bool(self.ok)),
        ("attempts", decode.option(self.attempts, decode.number)),
      ],
    )
  }
}

impl json.FromJson for Login {
  fn from_json(v: json.Value) -> Login / raise<json.Error> { try Login.read(v, "$") }
}

impl Key {
  /// The key that the JSON at `path` holds.
  pub fn read(v: json.Value, path: str) -> Key / raise<json.Error> {
    let ms = try decode.members(v, path, "Key")
    Key {
      space: try decode.text(try decode.field(ms, "space", path), "{path}.space"),
      id: try decode.int(try decode.field(ms, "id", path), "{path}.id"),
    }
  }
}

impl json.ToJson for Key {
  fn to_json(self) -> json.Value {
    json.Object([("space", json.Text(self.space)), ("id", decode.number(self.id))])
  }
}

impl json.FromJson for Key {
  fn from_json(v: json.Value) -> Key / raise<json.Error> { try Key.read(v, "$") }
}

impl Cache {
  /// What the cache did, as the JSON at `path` says.
  pub fn read(v: json.Value, path: str) -> Cache / raise<json.Error> {
    let (name, p) = decode.named(v) else raise decode.mismatch("Cache", v, path)
    let at = "{path}.{name}"
    match name {
      "Hit" => {
        let values = try decode.payload(p, at, 1, "(Key,)")
        Hit(try Key.read(values[0], "{at}[0]"))
      }
      "Miss" => {
        let values = try decode.payload(p, at, 1, "(Key,)")
        Miss(try Key.read(values[0], "{at}[0]"))
      }
      "Evict" => {
        let values = try decode.payload(p, at, 2, "(Key, i64)")
        Evict(try Key.read(values[0], "{at}[0]"), try decode.int(values[1], "{at}[1]"))
      }
      _ => raise decode.mismatch("Cache", v, path)
    }
  }
}

impl json.ToJson for Cache {
  fn to_json(self) -> json.Value {
    match self {
      Hit(k) => decode.variant("Hit", [k.to_json()])
      Miss(k) => decode.variant("Miss", [k.to_json()])
      Evict(k, n) => decode.variant("Evict", [k.to_json(), decode.number(n)])
    }
  }
}

impl json.FromJson for Cache {
  fn from_json(v: json.Value) -> Cache / raise<json.Error> { try Cache.read(v, "$") }
}
