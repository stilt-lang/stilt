// rbtree-ck: rbtree, keeping a list of every fifth tree it makes, which share most of their nodes,
// and folding over the last to count its true values (Reinking et al., Perceus, PLDI 2021).

type Color = | Red | Black

type Tree = | Leaf | Node(Color, Tree, i64, bool, Tree)

fn is_red(t: Tree) -> bool {
  match t {
    Node(Red, _, _, _, _) => true
    _ => false
  }
}

/// Rebalances a black node whose left child `l` is red.
fn balance_left(l: Tree, k: i64, v: bool, r: Tree) -> Tree {
  match l {
    Node(_, Node(Red, a, ka, va, b), kb, vb, c) => Node(
      Red,
      Node(Black, a, ka, va, b),
      kb,
      vb,
      Node(Black, c, k, v, r),
    )
    Node(_, a, ka, va, Node(Red, b, kb, vb, c)) => Node(
      Red,
      Node(Black, a, ka, va, b),
      kb,
      vb,
      Node(Black, c, k, v, r),
    )
    Node(_, a, ka, va, b) => Node(Black, Node(Red, a, ka, va, b), k, v, r)
    Leaf => Leaf
  }
}

/// Rebalances a black node whose right child `r` is red.
fn balance_right(l: Tree, k: i64, v: bool, r: Tree) -> Tree {
  match r {
    Node(_, Node(Red, a, ka, va, b), kb, vb, c) => Node(
      Red,
      Node(Black, l, k, v, a),
      ka,
      va,
      Node(Black, b, kb, vb, c),
    )
    Node(_, a, ka, va, Node(Red, b, kb, vb, c)) => Node(
      Red,
      Node(Black, l, k, v, a),
      ka,
      va,
      Node(Black, b, kb, vb, c),
    )
    Node(_, a, ka, va, b) => Node(Black, l, k, v, Node(Red, a, ka, va, b))
    Leaf => Leaf
  }
}

fn ins(t: Tree, k: i64, v: bool) -> Tree {
  match t {
    Node(Red, l, kx, vx, r) => if k < kx {
      Node(Red, ins(l, k, v), kx, vx, r)
    } else if k == kx {
      Node(Red, l, k, v, r)
    } else {
      Node(Red, l, kx, vx, ins(r, k, v))
    }
    Node(Black, l, kx, vx, r) => if k < kx {
      if is_red(l) {
        balance_left(ins(l, k, v), kx, vx, r)
      } else {
        Node(Black, ins(l, k, v), kx, vx, r)
      }
    } else if k == kx {
      Node(Black, l, k, v, r)
    } else if is_red(r) {
      balance_right(l, kx, vx, ins(r, k, v))
    } else {
      Node(Black, l, kx, vx, ins(r, k, v))
    }
    Leaf => Node(Red, Leaf, k, v, Leaf)
  }
}

fn set_black(t: Tree) -> Tree {
  match t {
    Node(_, l, k, v, r) => Node(Black, l, k, v, r)
    Leaf => Leaf
  }
}

fn insert(t: Tree, k: i64, v: bool) -> Tree {
  if is_red(t) { set_black(ins(t, k, v)) } else { ins(t, k, v) }
}

fn fold<A>(t: Tree, acc: A, f: fn(i64, bool, A) -> A) -> A {
  match t {
    Node(_, l, k, v, r) => fold(r, f(k, v, fold(l, acc, f)), f)
    Leaf => acc
  }
}

fn make_trees(n: i64, every: i64) -> List<Tree> {
  var trees = []
  var t = Leaf
  var k = n
  while k > 0 {
    t = insert(t, k, k % 10 == 0)
    if k % every == 0 { trees.push(t) }
    k -= 1
  }
  trees.push(t)
  trees
}

fn main() / io {
  let trees = make_trees(4200000, 5)
  let last = trees.last() else Leaf
  print("{fold(last, 0, |_, v, count| if v { count + 1 } else { count })}")
}
