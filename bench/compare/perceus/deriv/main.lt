// deriv: differentiates x^x ten times, simplifying each derivative as it is built, and prints the
// size of each (Reinking et al., Perceus, PLDI 2021).

type Expr = | Val(i64) | Var(str) | Add(Expr, Expr) | Mul(Expr, Expr) | Pow(Expr, Expr) | Ln(Expr)

fn pown(a: i64, n: i64) -> i64 {
  var r = 1
  for _ in 0..n { r *= a }
  r
}

fn add(a: Expr, b: Expr) -> Expr {
  match (a, b) {
    (Val(n), Val(m)) => Val(n + m)
    (Val(0), f) => f
    (f, Val(0)) => f
    (f, Val(n)) => add(Val(n), f)
    (Val(n), Add(Val(m), f)) => add(Val(n + m), f)
    (f, Add(Val(n), g)) => add(Val(n), add(f, g))
    (Add(f, g), h) => add(f, add(g, h))
    (f, g) => Add(f, g)
  }
}

fn mul(a: Expr, b: Expr) -> Expr {
  match (a, b) {
    (Val(n), Val(m)) => Val(n * m)
    (Val(0), _) => Val(0)
    (_, Val(0)) => Val(0)
    (Val(1), f) => f
    (f, Val(1)) => f
    (f, Val(n)) => mul(Val(n), f)
    (Val(n), Mul(Val(m), f)) => mul(Val(n * m), f)
    (f, Mul(Val(n), g)) => mul(Val(n), mul(f, g))
    (Mul(f, g), h) => mul(f, mul(g, h))
    (f, g) => Mul(f, g)
  }
}

fn pow(a: Expr, b: Expr) -> Expr {
  match (a, b) {
    (Val(m), Val(n)) => Val(pown(m, n))
    (_, Val(0)) => Val(1)
    (f, Val(1)) => f
    (Val(0), _) => Val(0)
    (f, g) => Pow(f, g)
  }
}

fn ln(e: Expr) -> Expr {
  match e {
    Val(1) => Val(0)
    f => Ln(f)
  }
}

/// The derivative of `e` by `x`.
fn d(x: str, e: Expr) -> Expr {
  match e {
    Val(_) => Val(0)
    Var(y) => if x == y { Val(1) } else { Val(0) }
    Add(f, g) => add(d(x, f), d(x, g))
    Mul(f, g) => add(mul(f, d(x, g)), mul(g, d(x, f)))
    Pow(f, g) => mul(pow(f, g), add(mul(mul(g, d(x, f)), pow(f, Val(-1))), mul(ln(f), d(x, g))))
    Ln(f) => mul(d(x, f), pow(f, Val(-1)))
  }
}

fn count(e: Expr) -> i64 {
  match e {
    Val(_) => 1
    Var(_) => 1
    Add(f, g) => count(f) + count(g)
    Mul(f, g) => count(f) + count(g)
    Pow(f, g) => count(f) + count(g)
    Ln(f) => count(f)
  }
}

fn main() / io {
  let x = Var("x")
  var f = pow(x, x)
  for i in 0..10 {
    f = d("x", f)
    print("{i + 1} count: {count(f)}")
  }
  print("done")
}
