// primes in parallel: counts the primes below a bound by trial division, in chunks that
// `par.map` counts and `par.fold` adds up.

use std.cli
use std.par

fn is_prime(n: i64) -> bool {
  if n < 2 { return false }
  var d = 2
  while d * d <= n {
    if n % d == 0 { return false }
    d += 1
  }
  true
}

/// The primes from `lo` to below `hi`.
fn count(lo: i64, hi: i64) -> i64 {
  var c = 0
  for n in lo..hi {
    if is_prime(n) { c += 1 }
  }
  c
}

fn main() / io {
  let bound = (cli.arg(0) else "").to_i64() else 8000000
  let chunk = 10000
  var starts = []
  var lo = 0
  while lo < bound {
    starts.push(lo)
    lo += chunk
  }
  let counts = par.map(starts, |s| count(s, (s + chunk).min(bound)))
  print("{par.fold(counts, 0, |a, b| a + b)} primes below {bound}")
}
