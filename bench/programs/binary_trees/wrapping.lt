// binary-trees: builds perfect binary trees bottom-up and counts their nodes, as the
// Benchmarks Game's program does, on one thread.

use std.cli

type Tree = | Leaf | Node(Tree, Tree)

fn make(depth: i64) -> Tree {
  if depth == 0 { Node(Leaf, Leaf) } else { Node(make(depth -% 1), make(depth -% 1)) }
}

fn check(tree: Tree) -> i64 {
  match tree {
    Leaf => 0
    Node(left, right) => 1 +% check(left) +% check(right)
  }
}

fn main() / io {
  let min_depth = 4
  let max_depth = (cli.arg(0) else "").to_i64() else 16
  let stretch = max_depth +% 1
  print("stretch tree of depth {stretch}\t check: {check(make(stretch))}")
  let long_lived = make(max_depth)
  var depth = min_depth
  while depth <= max_depth {
    let iterations = 1 << (max_depth -% depth +% min_depth)
    var total = 0
    for _ in 0..iterations { total +%= check(make(depth)) }
    print("{iterations}\t trees of depth {depth}\t check: {total}")
    depth +%= 2
  }
  print("long lived tree of depth {max_depth}\t check: {check(long_lived)}")
}
