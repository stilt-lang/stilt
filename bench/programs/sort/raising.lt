// The raising variant of main.lt (goal free-success): every function's row
// raises and every call of the program's functions goes through `try`, though nothing raises.

use std.cli

type Fail = | Fail

fn quicksort(inout xs: List<i64>, lo: i64, hi: i64) / raise<Fail> {
  if lo >= hi { return }
  let pivot = xs[(lo + hi) / 2]
  var i = lo
  var j = hi
  while i <= j {
    while xs[i] < pivot { i += 1 }
    while xs[j] > pivot { j -= 1 }
    if i <= j {
      let t = xs[i]
      xs[i] = xs[j]
      xs[j] = t
      i += 1
      j -= 1
    }
  }
  try quicksort(inout xs, lo, j)
  try quicksort(inout xs, i, hi)
}

fn checksum(xs: List<i64>) -> i64 / raise<Fail> {
  var sum = 0
  for i in 0..xs.len() { sum = (sum * 31 + xs[i]) % 1000000007 }
  sum
}

fn main() / {io, raise<Fail>} {
  let size = (cli.arg(0) else "").to_i64() else 400000
  var xs = []
  var x = 1
  for _ in 0..size {
    x = (x * 1103515245 + 12345) % 2147483648
    xs.push(x % 1000000)
  }
  let sorted = xs.sorted()
  var quick = xs
  try quicksort(inout quick, 0, quick.len() - 1)
  let by_digit = xs.sorted_by(|v| v % 10)
  print("{try checksum(sorted)} {try checksum(quick)} {try checksum(by_digit)}")
}
