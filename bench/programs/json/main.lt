// json: writes a JSON document of 20000 records, parses it back into a tree with a
// recursive-descent parser, and sums what the tree holds.

use std.cli

type Json =
  | Null
  | Bool(bool)
  | Num(i64)
  | Text(str)
  | Array(List<Json>)
  | Object(List<(str, Json)>)

fn document(n: i64) -> str {
  var parts = []
  for i in 0..n {
    let active = if i % 3 == 0 { "true" } else { "false" }
    let note = if i % 5 == 0 { "null" } else { "\"line\\none \\\"{i}\\\"\"" }
    parts.push("\{\"id\": {i}, \"name\": \"item{i}\", \"active\": {active}, \"tags\": [\"a\", \"b{i % 4}\"], \"point\": \{\"x\": {i % 7}, \"y\": [1, 2, {i % 11}]}, \"note\": {note}}")
  }
  "[{", ".join(parts)}]"
}

fn skip_space(text: List<u8>, inout pos: i64) {
  while pos < text.len() && (text[pos] == 32 || text[pos] == 10) { pos += 1 }
}

fn string(source: str, text: List<u8>, inout pos: i64) -> str {
  pos += 1
  var pieces = []
  var start = pos
  while text[pos] != 34 {
    if text[pos] == 92 {
      pieces.push(source.slice(start, pos))
      let escaped = text[pos + 1]
      pieces.push(if escaped == 110 { "\n" } else { source.slice(pos + 1, pos + 2) })
      pos += 2
      start = pos
    } else {
      pos += 1
    }
  }
  pieces.push(source.slice(start, pos))
  pos += 1
  "".join(pieces)
}

fn number(text: List<u8>, inout pos: i64) -> i64 {
  var n = 0
  while pos < text.len() && text[pos] >= 48 && text[pos] <= 57 {
    n = n * 10 + (text[pos] - 48).to_i64()
    pos += 1
  }
  n
}

fn value(source: str, text: List<u8>, inout pos: i64) -> Json {
  skip_space(text, inout pos)
  let c = text[pos]
  if c == 123 {
    pos += 1
    var fields = []
    skip_space(text, inout pos)
    while text[pos] != 125 {
      skip_space(text, inout pos)
      let key = string(source, text, inout pos)
      skip_space(text, inout pos)
      pos += 1
      fields.push((key, value(source, text, inout pos)))
      skip_space(text, inout pos)
      if text[pos] == 44 { pos += 1 }
    }
    pos += 1
    Object(fields)
  } else if c == 91 {
    pos += 1
    var items = []
    skip_space(text, inout pos)
    while text[pos] != 93 {
      items.push(value(source, text, inout pos))
      skip_space(text, inout pos)
      if text[pos] == 44 { pos += 1 }
    }
    pos += 1
    Array(items)
  } else if c == 34 {
    Text(string(source, text, inout pos))
  } else if c == 116 {
    pos += 4
    Bool(true)
  } else if c == 102 {
    pos += 5
    Bool(false)
  } else if c == 110 {
    pos += 4
    Null
  } else {
    Num(number(text, inout pos))
  }
}

type Totals = { numbers: i64, texts: i64, trues: i64, nulls: i64, nodes: i64 }

fn add(inout totals: Totals, json: Json) {
  totals.nodes += 1
  match json {
    Null => { totals.nulls += 1 }
    Bool(b) => if b { totals.trues += 1 }
    Num(n) => { totals.numbers += n }
    Text(s) => { totals.texts += s.len() }
    Array(items) => for item in items { add(inout totals, item) }
    Object(fields) => for (key, item) in fields {
      totals.texts += key.len()
      add(inout totals, item)
    }
  }
}

fn main() / io {
  let size = (cli.arg(0) else "").to_i64() else 20000
  let source = document(size)
  let text = source.bytes()
  var pos = 0
  let json = value(source, text, inout pos)
  var totals = Totals { numbers: 0, texts: 0, trues: 0, nulls: 0, nodes: 0 }
  add(inout totals, json)
  print("{source.len()} bytes, {totals.nodes} nodes")
  print("numbers {totals.numbers}, text {totals.texts}, true {totals.trues}, null {totals.nulls}")
}
