// The raising variant of main.lt (goal free-success): every function's row
// raises and every call of the program's functions goes through `try`, though nothing raises.

use std.cli

type Fail = | Fail

fn next(x: i64) -> i64 / raise<Fail> { (x * 1103515245 + 12345) % 2147483648 }

fn main() / {io, raise<Fail>} {
  let n = (cli.arg(0) else "").to_i64() else 300000
  var numbers = Map.new()
  var x = 42
  for i in 0..n {
    x = try next(x)
    numbers[x % 100000] = i
  }
  var hits = 0
  for _ in 0..n {
    x = try next(x)
    if numbers.contains(x % 200000) { hits += 1 }
  }
  for k in 0..50000 { let _ = numbers.remove(k * 2) }
  var sum = 0
  for (k, v) in numbers { sum += k ^ v }
  print("{numbers.len()} numbers, {hits} hits, checksum {sum}")

  var words = Map.with_default(0)
  for _ in 0..n {
    x = try next(x)
    words["w{x % 5000}"] += 1
  }
  var longest = 0
  var most = 0
  for (w, count) in words {
    if w.len() > longest { longest = w.len() }
    if count > most { most = count }
  }
  print("{words.len()} words, longest {longest}, most {most}")
}
