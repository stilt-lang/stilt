// closures: folds a list through a closure, then through a function that takes one.

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn main() / io {
  var xs = []
  for i in 0..1000 { xs.push(i) }
  var total = 0
  for round in 0..30000 {
    total = xs.fold(total, |acc, x| (acc + x * round) % 1000003)
    total = apply(|x| (x + round) % 1000003, total)
  }
  print("{total}")
}
