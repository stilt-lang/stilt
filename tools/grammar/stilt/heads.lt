// The heads of expressions.heads, derived from `expr` as `reference/03-syntax.md` defines them under
// "Heads": the rules of `expr`, `postfix`, `built`, `primary` and `catch_arm` get a copy with
// the suffix `_h`, in which the struct literal, block, `if`, `match`, loop, `with`, `when`
// and `unsafe` forms, the handler literal, the staging annotations, the block form of `catch` and
// the trailing block of a `macro_use` are missing, and which refers to the copies wherever an
// expression stands outside `(…)` and `[…]`.

use ebnf
use expand

/// The rules that a head copies.
const FAMILY: List<str> = ["expr", "postfix", "built", "primary", "catch_arm"]

/// The primary forms that a head leaves out.
const LEFT_OUT_RULES: List<str> = ["struct", "block", "if"]

/// The keywords that start the primary forms a head leaves out.
const LEFT_OUT_KEYWORDS: List<str> = [
  "match", "loop", "while", "for", "with", "when", "unsafe", "handler", "comptime",
]

/// Adds the copy of each rule of the family, and points `head` at the copy of `expr`.
pub fn derive(inout grammar: expand.Grammar) / raise<str> {
  for name in FAMILY {
    let body = grammar.get(name) else raise "the heads need a rule `{name}`"
    grammar.set("{name}_h", headed(body, 0))
  }
  grammar.rules = grammar.rules.map(|rule| (rule.0, rename_head(rule.1)))
}

/// `expr` with every use of `head` pointing at the copy of `expr`.
/// ex: rename_head(ebnf.Seq([ebnf.Ref("head"), ebnf.Opt(ebnf.Ref("head"))])) == ebnf.Seq([ebnf.Ref("expr_h"), ebnf.Opt(ebnf.Ref("expr_h"))])
fn rename_head(expr: ebnf.Expr) -> ebnf.Expr {
  match expr {
    Ref("head") => ebnf.Ref("expr_h")
    Seq(items) => ebnf.Seq(items.map(rename_head))
    Alt(items) => ebnf.Alt(items.map(rename_head))
    Opt(inner) => ebnf.Opt(rename_head(inner))
    Star(inner) => ebnf.Star(rename_head(inner))
    _ => expr
  }
}

/// The copy of `expr`, found at bracket depth `depth`.
fn headed(expr: ebnf.Expr, depth: i64) -> ebnf.Expr {
  match expr {
    Ref(name) if depth == 0 && FAMILY.contains(name) => ebnf.Ref("{name}_h")
    Seq(items) => {
      var depth = depth
      var out = []
      for item in items {
        if depth == 0 && is_left_out_option(item) { continue }
        out.push(headed(item, depth))
        match item {
          Lit("(") | Lit("[") => { depth += 1 }
          Lit(")") | Lit("]") => { depth = (depth - 1).max(0) }
          _ => {}
        }
      }
      ebnf.Seq(out)
    }
    Alt(items) => {
      let kept = items.filter(|branch| !left_out(branch)).map(|branch| headed(branch, depth))
      match kept {
        [only] => only
        _ => ebnf.Alt(kept)
      }
    }
    Opt(inner) => ebnf.Opt(headed(inner, depth))
    Star(inner) => ebnf.Star(headed(inner, depth))
    _ => expr
  }
}

/// Whether the item is an option that a head leaves out, the trailing block of a `macro_use`.
/// ex: is_left_out_option(ebnf.Opt(ebnf.Seq([ebnf.Lit("\{"), ebnf.Ref("tokens")])))
/// ex: !is_left_out_option(ebnf.Seq([ebnf.Lit("\{"), ebnf.Ref("tokens")]))
fn is_left_out_option(item: ebnf.Expr) -> bool {
  match item {
    Opt(inner) => left_out(inner)
    _ => false
  }
}

/// Whether the alternative is a form that a head leaves out, by its first element: a struct
/// literal, block, `if`, `match`, loop or staging annotation, or the `{` of the block form of
/// `catch`.
/// ex: left_out(ebnf.Ref("block"))
/// ex: left_out(ebnf.Seq([ebnf.Lit("match"), ebnf.Ref("head")]))
/// ex: !left_out(ebnf.Ref("call"))
fn left_out(branch: ebnf.Expr) -> bool {
  match branch {
    Ref(name) => LEFT_OUT_RULES.contains(name)
    Lit(text) => text == "\{" || LEFT_OUT_KEYWORDS.contains(text)
    Seq(items) => items.first().is_some_and(left_out)
    _ => false
  }
}
