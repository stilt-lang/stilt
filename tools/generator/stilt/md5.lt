// The MD5 digest of RFC 1321, which seeds the generator as OCaml's
// `Random.State.make` does.

/// The amounts the steps of each round rotate by, in turn.
const SHIFTS: List<List<u32>> = [[7, 12, 17, 22], [5, 9, 14, 20], [4, 11, 16, 23], [6, 10, 15, 21]]

/// The constant each step adds, eight steps to a row: the integer part of
/// `2^32 * |sin(i + 1)|` for step `i`.
const SINES: List<List<u32>> = [
  [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501],
  [0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821],
  [0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8],
  [0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a],
  [0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70],
  [0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665],
  [0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1],
  [0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391],
]

/// The four words of the digest so far.
type Words = { a: u32, b: u32, c: u32, d: u32 }

/// The 16 bytes of the MD5 digest of `bytes`.
/// ex: hex(digest([])) == "d41d8cd98f00b204e9800998ecf8427e"
/// ex: hex(digest("abc".bytes())) == "900150983cd24fb0d6963f7d28e17f72"
/// ex: hex(digest("a".repeat(64).bytes())) == "014842d480b571495a4a0363793f7367"
pub fn digest(bytes: List<u8>) -> List<u8> {
  var w = Words { a: 0x67452301, b: 0xefcdab89, c: 0x98badcfe, d: 0x10325476 }
  let padded = pad(bytes)
  var start = 0
  while start < padded.len() {
    w = block(w, padded.slice(start, start + 64))
    start += 64
  }
  var out = []
  for word in [w.a, w.b, w.c, w.d] {
    for shift in [0, 8, 16, 24] { out.push((word >> shift).wrap_to_u8()) }
  }
  out
}

/// `bytes` followed by `0x80`, zeros up to 8 bytes short of a multiple of 64,
/// and its length in bits as a little-endian `u64`.
fn pad(bytes: List<u8>) -> List<u8> {
  var out = bytes
  out.push(0x80)
  while out.len() % 64 != 56 { out.push(0) }
  let bits = bytes.len().wrap_to_u64() *% 8
  for shift in 0..8 { out.push((bits >> (shift.wrap_to_u64() * 8)).wrap_to_u8()) }
  out
}

/// The words after the 64 steps on one block of 64 bytes.
fn block(w: Words, bytes: List<u8>) -> Words {
  let m = List.generate(16, |j| word(bytes, 4 * j))
  var a = w.a
  var b = w.b
  var c = w.c
  var d = w.d
  for i in 0..64 {
    let (f, g) = match i / 16 {
      0 => ((b & c) | (!b & d), i)
      1 => ((d & b) | (!d & c), (5 * i + 1) % 16)
      2 => (b ^ c ^ d, (3 * i + 5) % 16)
      _ => (c ^ (b | !d), (7 * i) % 16)
    }
    let sum = f +% a +% SINES[i / 8][i % 8] +% m[g]
    a = d
    d = c
    c = b
    b = b +% rotate(sum, SHIFTS[i / 16][i % 4])
  }
  Words { a: w.a +% a, b: w.b +% b, c: w.c +% c, d: w.d +% d }
}

/// The little-endian word at byte `at` of `bytes`.
fn word(bytes: List<u8>, at: i64) -> u32 {
  bytes[at].to_u32() |
    bytes[at + 1].to_u32() << 8 |
    bytes[at + 2].to_u32() << 16 |
    bytes[at + 3].to_u32() << 24
}

/// `x` rotated left by `k` bits, for `k` from 1 to 31.
/// ex: rotate(0x80000001, 1) == 3
fn rotate(x: u32, k: u32) -> u32 { x << k | x >> (32 - k) }

/// `bytes` in lowercase hexadecimal, two digits each.
/// ex: hex([0, 171]) == "00ab"
pub fn hex(bytes: List<u8>) -> str { "".join(bytes.map(|b| "{b:0>2x}")) }
