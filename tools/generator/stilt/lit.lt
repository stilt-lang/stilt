// Literals, as lexical.integer-literals, lexical.float-literals and lexical.string-literals writes them. Values near the ends of each range are
// more likely than the rest, since that is where implementations disagree.

use pick
use ty

/// The bounds of an integer type, as decimal text.
/// ex: bounds(ty.I8) == ("-128", "127")
pub fn bounds(k: ty.IntKind) -> (str, str) {
  match k {
    I8 => ("-128", "127")
    I16 => ("-32768", "32767")
    I32 => ("-2147483648", "2147483647")
    I64 => ("-9223372036854775808", "9223372036854775807")
    U8 => ("0", "255")
    U16 => ("0", "65535")
    U32 => ("0", "4294967295")
    U64 => ("0", "18446744073709551615")
  }
}

/// A value of `k` from all of its range, as decimal text: the low bits of a
/// draw, read as `k` reads them.
/// ex: { var r = pick.make(7); anywhere(inout r, ty.I8) == "-53" }
pub fn anywhere(inout r: pick.Rng, k: ty.IntKind) -> str {
  let n = pick.next(inout r)
  let width = ty.bits(k)
  if width == 64 { return if ty.signed(k) { "{n.wrap_to_i64()}" } else { "{n}" } }
  let low = (n & ((1 << width.wrap_to_u64()) - 1)).wrap_to_i64()
  if ty.signed(k) && low >= 1 << (width - 1) { "{low - (1 << width)}" } else { "{low}" }
}

/// An integer literal of `k`, as decimal text.
/// ex: { var r = pick.make(5); [int(inout r, ty.I8), int(inout r, ty.U64), int(inout r, ty.I32)] == ["-13", "0", "-2147483648"] }
pub fn int(inout r: pick.Rng, k: ty.IntKind) -> str {
  let small = if ty.signed(k) { pick.between(inout r, -9, 9) } else { pick.between(inout r, 0, 9) }
  let (lo, hi) = bounds(k)
  let far = anywhere(inout r, k)
  match pick.weighted(inout r, [6, 1, 1, 2]) {
    0 => "{small}"
    1 => lo
    2 => hi
    _ => far
  }
}

/// A finite float that every float type can hold. The digits after the point
/// are drawn before those before it, and the exponent before the form.
/// ex: { var r = pick.make(5); float(inout r) == "675.871" && float(inout r) == "-47.393e7" }
pub fn float(inout r: pick.Rng) -> str {
  let fraction = pick.between(inout r, 0, 999)
  let whole = pick.between(inout r, 0, 999)
  let mantissa = "{whole}.{fraction}"
  let exponent = pick.between(inout r, -20, 20)
  let text = match pick.weighted(inout r, [5, 2, 1, 1]) {
    0 => mantissa
    1 => "{mantissa}e{exponent}"
    2 => "0.0"
    _ => "1.0"
  }
  if pick.chance(inout r, 0.3) { "-{text}" } else { text }
}

/// The weights of the pieces of a string: a letter, a space, a comma, a
/// digit, and the escapes of lexical.escapes, with a lone `}`.
const PIECES: List<i64> = [12, 2, 2, 2, 1, 1, 1, 1, 1, 1]

/// The text inside a string literal, ASCII only. Each piece draws its digit,
/// then its letter, then which piece it is.
/// ex: { var r = pick.make(5); string_body(inout r) == "\\\{jw6v" && string_body(inout r) == ",\\\\1sk" }
pub fn string_body(inout r: pick.Rng) -> str {
  let n = pick.between(inout r, 0, 6)
  var pieces = []
  for _ in 0..n {
    let digit = pick.below(inout r, 10)
    let letter = pick.between(inout r, 97, 122)
    pieces.push(
      match pick.weighted(inout r, PIECES) {
        0 => str.from_code_point(letter.wrap_to_u32()) else unreachable()
        1 => " "
        2 => ","
        3 => "{digit}"
        4 => "\\n"
        5 => "\\t"
        6 => "\\\""
        7 => "\\\\"
        8 => "\\\{"
        _ => "}"
      },
    )
  }
  "".join(pieces)
}

pub fn string(inout r: pick.Rng) -> str {
  let body = string_body(inout r)
  "\"{body}\""
}
