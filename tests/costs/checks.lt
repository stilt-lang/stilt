// The checks of each function that verification proves, which a release build drops, and those
// it keeps (verification's proof rules, reference/15-facts.md; builds.performance-report).

fn pick(xs: List<i64>, i: i64) -> i64 { //~ ONCE
  xs[i] //~ KEPT bounds
}

fn first(xs: List<i64>) -> i64 { //~ ONCE
  if xs.len() > 0 { xs[0] } else { 0 } //~ PROVED bounds
}

fn ratio(a: i64, b: i64) -> i64 { //~ ONCE
  if b == 0 { 0 } else { a / b } //~ PROVED divide-by-zero KEPT overflow
}

fn lookup(m: Map<str, i64>, k: str) -> i64 { //~ ONCE
  m[k] //~ KEPT missing-key
}

fn known(m: Map<str, i64>, k: str) -> i64 { //~ ONCE
  if m.contains(k) { m[k] } else { 0 } //~ PROVED missing-key
}

fn main() / io { //~ ONCE
  var m: Map<str, i64> = Map.new()
  m["a"] = 1
  print("{pick([1, 2], 1)} {first([4])} {ratio(6, 3)} {lookup(m, "a")} {known(m, "b")}")
}
