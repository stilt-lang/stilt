(include_subdirs unqualified)

(library
 (name stilt)
 (libraries menhirLib unix)
 (modules_without_implementation ast hir tast)
 (foreign_stubs
  (language c)
  (names foreign_stubs))
 (c_library_flags (-lffi)))

; The interpreter calls C through libffi (c.both-implementations), from stubs of its
; own, so that the switch needs no package for it: macOS's SDK holds libffi, and
; Linux's libffi-dev.

; The standard library's sources are built into the interpreter.

(rule
 (target std_files.ml)
 (deps
  (glob_files_rec %{project_root}/std/*.lt))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../gen/embed.exe} %{project_root}/std %{deps}))))

; The names an exported function may not take (c.exported-names), which the
; compiler reads too.

(rule
 (target c_names.ml)
 (deps %{project_root}/reference/c-names.txt)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let text = {|")
    (cat %{deps})
    (echo "|}\n")))))

; The grammar is split over files by the sections of reference/03-syntax.md, which
; Menhir joins into one parser. --strict turns every conflict into an error, so
; the grammar stays free of ambiguities that its precedence declarations don't
; settle. --table provides the incremental interface, through which the driver
; asks whether a contextual keyword, or a token of a macro, is accepted, and
; through which a macro's fragments are matched. The tokens the grammar never
; accepts are reserved (lexical.reserved-tokens), or mark a misplaced doc comment.

(menhir
 (modules
  parser
  parser_declarations
  parser_macros
  parser_types
  parser_patterns
  parser_expressions)
 (merge_into parser)
 (flags
  --strict
  --table
  --external-tokens
  Token
  --unused-token
  AT
  --unused-token
  TICK
  --unused-token
  HASH
  --unused-token
  MISPLACED_DOC))
