{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Highlights Stilt in a Markdown file's fenced code block whose language is `stilt` or `lt`, attributes after it included, as the guide's `stilt pass:3` blocks write them.",
  "scopeName": "markdown.stilt.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#fenced-block" }],
  "repository": {
    "fenced-block": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(stilt|lt)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "endCaptures": { "3": { "name": "punctuation.definition.markdown" } },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.stilt",
          "patterns": [{ "include": "source.stilt" }]
        }
      ]
    }
  }
}
