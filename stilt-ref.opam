# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "The reference interpreter for Stilt"
description:
  "stilt-ref defines the observable behaviour of Stilt programs. Every other implementation is tested against it."
maintainer: ["The Stilt Project Contributors"]
authors: ["The Stilt Project Contributors"]
license: "MIT OR Apache-2.0"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.5"}
  "cmdliner" {>= "2.1"}
  "menhir" {>= "20260209"}
  "ppx_expect" {with-test & >= "v0.17"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "js_of_ocaml" {with-dev-setup & = "6.5.0"}
  "js_of_ocaml-compiler" {with-dev-setup & = "6.5.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
