// The rule that the board follows and how it looks. Edit this file while `stilt run` runs the
// program, and each saved edit takes effect at the next generation, with the board kept.

/// Whether a dead cell with `n` live neighbours comes alive: B3 is Conway's rule, and
/// `n == 3 || n == 6` is HighLife's, where small replicators copy themselves.
pub fn born(n: i64) -> bool { n == 3 }

/// Whether a live cell with `n` live neighbours stays alive: S23 is Conway's rule.
pub fn survives(n: i64) -> bool { n == 2 || n == 3 }

/// How a cell that has been alive for `age` generations is drawn, two columns wide, in one of
/// the terminal's 256 colours.
pub fn look(age: i64) -> str {
  let colour = if age < 2 { 231 } else if age < 5 { 229 } else if age < 20 { 215 } else { 167 }
  "\u{1b}[38;5;{colour}m██"
}
